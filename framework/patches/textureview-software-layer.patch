     /**
+     * Minato: the current frame drawn into `width` x `height` with the SurfaceTexture's transform, as hwui samples
+     * the layer's texture, then `transform`, the view's, with `paint`, the layer's, filtered as the texture is;
+     * `copy` replaces what is under it, as getBitmap's readback does. Opaque, the frame's alpha is not drawn.
+     */
+    private void drawSoftwareFrame(Canvas canvas, int width, int height, Matrix transform, Paint paint,
+            boolean copy) {
+        Bitmap frame = mSoftwareFrame;
+        if (frame == null || mSurface == null || width <= 0 || height <= 0) {
+            return;
+        }
+        // The texture's coordinates (s, t) of the view's (u, v), v upwards: s = m0 u + m4 v + m12,
+        // t = m1 u + m5 v + m13; the frame's pixel (x, y) is at (x / its width, y / its height).
+        float[] m = mSoftwareTransform;
+        mSurface.getTransformMatrix(m);
+        float[] values = mSoftwareValues;
+        values[0] = m[0];
+        values[1] = m[4];
+        values[2] = m[12];
+        values[3] = m[1];
+        values[4] = m[5];
+        values[5] = m[13];
+        values[6] = 0;
+        values[7] = 0;
+        values[8] = 1;
+        mSoftwareTexture.setValues(values);
+        Matrix toView = mSoftwareToView;
+        if (!mSoftwareTexture.invert(toView)) {
+            return;
+        }
+        toView.preScale(1f / frame.getWidth(), 1f / frame.getHeight());
+        toView.postScale(width, -height);
+        toView.postTranslate(0, height);
+        if (frame.getConfig() == Bitmap.Config.ARGB_8888) {
+            frame.setHasAlpha(!mOpaque);
+        }
+        frame.setDensity(Bitmap.DENSITY_NONE);
+        mSoftwarePaint.reset();
+        if (paint != null) {
+            mSoftwarePaint.set(paint);
+        }
+        mSoftwarePaint.setFilterBitmap(true);
+        if (copy) {
+            mSoftwarePaint.setXfermode(mSoftwareCopy);
+        }
+        int saveCount = canvas.save();
+        if (transform != null) {
+            canvas.concat(transform);
+        }
+        // As hwui draws the layer into the view's rectangle: what lies outside the frame's crop is not drawn.
+        canvas.clipRect(0, 0, width, height);
+        canvas.concat(toView);
+        canvas.drawBitmap(frame, 0, 0, mSoftwarePaint);
+        canvas.restoreToCount(saveCount);
+    }
