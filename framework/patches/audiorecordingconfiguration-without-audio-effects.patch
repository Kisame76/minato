-    private final AudioEffect.Descriptor[] mClientEffects;
+    private final Object[] mClientEffects;  // Minato: AudioEffect.Descriptors, none ever (see the patch's header)
 
-    private final AudioEffect.Descriptor[] mDeviceEffects;
+    private final Object[] mDeviceEffects;
 
