{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos",
      "inherits": "base",
      "displayName": "macOS: tests and host tools, with ASan and UBSan",
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "APK_SANITIZE": "ON"
      }
    },
    {
      "name": "ios",
      "inherits": "base",
      "displayName": "iOS device: libraries for the app",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
      }
    },
    {
      "name": "ios-simulator",
      "inherits": "ios",
      "displayName": "iOS Simulator: libraries for the app",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },
    {
      "name": "ios-release",
      "inherits": "ios",
      "displayName": "iOS device: optimized libraries for the benchmark build (ADR-0037)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ios-simulator-release",
      "inherits": "ios-simulator",
      "displayName": "iOS Simulator: optimized libraries for the benchmark build (ADR-0037)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos", "configurePreset": "macos" },
    { "name": "ios", "configurePreset": "ios" },
    { "name": "ios-simulator", "configurePreset": "ios-simulator" },
    { "name": "ios-release", "configurePreset": "ios-release" },
    { "name": "ios-simulator-release", "configurePreset": "ios-simulator-release" }
  ],
  "testPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
