<?xml version="1.0" encoding="utf-8"?>
<!-- sdk-extensions-test: android.os.ext.SdkExtensions, which libraries ask for the version of an SDK extension
     (getExtensionVersion) and for all of them (getAllExtensionVersions). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.sdkextensions" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.sdkextensions.ExtensionsActivity" android:exported="true"
        android:label="@string/app_name">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
