<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0073's characteristics dump (camera-characteristics-test), without the CAMERA permission: camera2's cameras with every
     characteristics key and its value's type (values to the device tag), the camera features, the legacy Camera's
     cameras and, with the permission, its parameters. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.cameracharacteristics" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <application android:label="Camera Characteristics Test"
      android:name="io.github.kisame76.minato.test.cameracharacteristics.CameraApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
