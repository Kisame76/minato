<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the accessibility data classes that apps and libraries fill and read (accessibility-answers-test):
     the node info with its actions, collection and range infos, a view's own node info and the parcel round trip,
     the window info and the service info, each with the answer Android 15 gives. The launcher activity is the
     framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.accessibility" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.accessibility.AccessibilityApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
