<?xml version="1.0" encoding="utf-8"?>
<!-- The test of two groups of classes that apps and libraries name (batch G): the keystore's exceptions and key
     protection, and the backup manager with its agent and helpers, each with Android 15's answer. The launcher activity is the framework's
     own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.batchg" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:allowBackup="true"
      android:backupAgent="io.github.kisame76.minato.test.batchg.TestBackupAgent"
      android:name="io.github.kisame76.minato.test.batchg.BatchGApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
