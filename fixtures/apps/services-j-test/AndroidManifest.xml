<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the network system services of bundle C of the service inventory, part 1 (services-j-test): the IPsec,
     VPN management and connectivity diagnostics managers, each asked for by name and by class, with every zero-argument
     getter and predicate of its class called, logging the result or the class of the exception, as Android 15 on
     apk-runner-35-bare answers an app that holds no permission of them. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.servicesj" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.servicesj.ServicesJApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
