<?xml version="1.0" encoding="utf-8"?>
<!-- ime-extract-test (ADR-0068, the host's text bar): a note field and a password field, and, for the Android reference
     only, a fixture input method that shows the text as a keyboard with a text bar does: it asks the field for its
     extracted text (without GET_EXTRACTED_TEXT_MONITOR) and hears of each change, which it logs. Minato has no input
     method service: its guest asks and tells the host, and apk-run's text steps post the same edits. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.imeextract" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.imeextract.ExtractActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:windowSoftInputMode="stateHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name="io.github.kisame76.minato.test.imeextract.FixtureInputMethod" android:exported="true"
        android:label="@string/ime_name" android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod"/>
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
  </application>
</manifest>
