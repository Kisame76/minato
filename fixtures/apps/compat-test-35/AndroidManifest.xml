<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c2e's twin test (compat-test-35): compat-test's app, from the same sources
     (fixtures/java/compat-test), built for targetSdk 35, so that each change shows on both sides of its target. The
     launcher activity is the framework's own android.app.Activity, so that `am start` starts the process on
     Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.compat35" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
  <application android:label="Compat Test 35"
      android:name="io.github.kisame76.minato.test.compat.CompatApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
