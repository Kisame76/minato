<?xml version="1.0" encoding="utf-8"?>
<!-- The test of single answers that apps ask for (services-e-test): the service names dropbox, tv_input and
     content_capture, the content capture session of a view, MediaDrm and SubscriptionManager.getSlotIndex, each with the
     answer or the exception Android 15 gives an app that holds none of their permissions. The launcher activity is the
     framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.servicese" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.servicese.ServicesEApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
