<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039's test of an exception that no thread catches (crash-test): CrashApplication installs a default handler
     as a crash reporter does, which logs the exception and hands it on to the handler before it; CrashActivity, the
     launcher, throws from a message on the main thread, so that the exception leaves Looper.loop and
     ActivityThread.main, and Android's own handlers end the process. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.crash" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
      android:name="io.github.kisame76.minato.test.crash.CrashApplication">
    <activity android:name="io.github.kisame76.minato.test.crash.CrashActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
