<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0057 step d's test (saves-test): an app saves a document with the system picker and works in a folder
     the user opened for it: the documents provider's create, rename and delete, the tree URIs and the grants. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.saves" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".SavesActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
