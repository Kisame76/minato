<?xml version="1.0" encoding="utf-8"?>
<!-- The test of fields through JNI and java.lang.reflect (jni-fields-test; the Unity test APK probe: Unity finds a field such
     as UnityPlayer.currentActivity by reflection, then asks JNI for it with the signature reflection gave): lookups
     exact and with a supertype's signature, static and instance, reflection's fields, types and their names, and the
     bridges FromReflectedField and ToReflectedField. The launcher activity is the framework's own android.app.Activity,
     so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.jnifields" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.jnifields.JniFieldsApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
