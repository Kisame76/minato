<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0043 step e1) (checkbox-test): the Application class inflates res/layout/boxes.xml's CheckBoxes, makes one in
     code and logs what each answers, without a window. The launcher activity is the framework's own
     android.app.Activity, as in drawables-test; the driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.checkbox" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="CheckBox Test"
      android:name="io.github.kisame76.minato.test.checkbox.CheckBoxApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
