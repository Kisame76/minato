<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c2e's test (compat-test): what an app's target SDK changes in its own process, for an app built for
     Android 9, targetSdk 28. fixtures/apps/compat-test-35 is the same app for targetSdk 35, from the same sources
     (fixtures/java/compat-test). The launcher activity is the framework's own android.app.Activity, so that `am start`
     starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.compat" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28"/>
  <application android:label="Compat Test"
      android:name="io.github.kisame76.minato.test.compat.CompatApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
