<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the system services of bundle B of the service inventory (services-h-test): the app search, blob store,
     bugreport, companion device, credential, cross-profile apps, device lock, display hash, domain verification, file
     integrity, health connect, media communication, overlay, people and virtual device managers, each asked for by name
     and by class, with every zero-argument getter and predicate of its class called, logging the result or the class of
     the exception, as Android 15 on apk-runner-35-bare answers an app that holds no permission of them. The launcher
     activity is the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.servicesh" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.servicesh.ServicesHApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
