<?xml version="1.0" encoding="utf-8"?>
<!-- The Dialog-themed window of the black-screen sweep: a launcher activity with Theme.DeviceDefault.Dialog, a
     floating software window (hardwareAccelerated="false") sized by the activity, filled with one opaque colour and
     posted once. The floating window's buffer must stay shown over the dim; a dialog-themed start window must not go
     black. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.dialogdecor" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:hardwareAccelerated="false">
    <activity android:name="io.github.kisame76.minato.test.dialogdecor.DialogDecorActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.Dialog">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
