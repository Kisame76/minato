<?xml version="1.0" encoding="utf-8"?>
<!-- The test of an app's network_security_config.xml (network-security-config-test; framework breadth, step (d)): a base
     config without clear text, a domain with it, a pin-set that no chain fits, and debug-overrides, which a non-debuggable
     app ignores. The launcher activity is the framework's own android.app.Activity, so that `am start` starts the
     process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.networksecurityconfig" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:label="network-security-config-test" android:networkSecurityConfig="@xml/network_security_config"
      android:name="io.github.kisame76.minato.test.networksecurityconfig.NetworkSecurityConfigApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
