<?xml version="1.0" encoding="utf-8"?>
<!-- The framework breadth's behavior test (breadth-test): the Application class uses each batch's types without a window
     and logs what they answer. The launcher activity is the framework's own android.app.Activity, as in widgets-test;
     the driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.breadth" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Breadth Test"
      android:name="io.github.kisame76.minato.test.breadth.BreadthApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
