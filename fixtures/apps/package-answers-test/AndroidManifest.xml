<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the package manager's answers for the app's own package (package-answers-test; the package manager stub
     plan, P1 on): the Resources getResourcesForApplication and getResourcesForActivity give, with and without a
     configuration, and what an unknown package or activity meets. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.packageanswers" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="package-answers-test"
      android:name="io.github.kisame76.minato.test.packageanswers.PackageAnswersApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
