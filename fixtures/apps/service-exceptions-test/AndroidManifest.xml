<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the exceptions a service start can throw (service-exceptions-test; framework breadth, step (b)): the
     classes and their hierarchy, as an app's catch blocks see them. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.serviceexceptions" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="service-exceptions-test" android:name="io.github.kisame76.minato.test.serviceexceptions.ServiceExceptionsApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
