<?xml version="1.0" encoding="utf-8"?>
<!-- M6's baseline of the Java apps' frame times (frame-bench): a view tree whose texts change every frame, and
     animators on its views, each for 240 frames; the frame's time from Choreographer's frame time to its commit
     callback (after the traversal). Runtime-only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.framebench" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="frame-bench">
    <activity android:name="io.github.kisame76.minato.test.framebench.FrameBenchActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
