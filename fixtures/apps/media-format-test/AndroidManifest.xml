<?xml version="1.0" encoding="utf-8"?>
<!-- The test of android.media.MediaFormat (media-format-test; the Unity test APK gap sort, category 3m): the key-value map that
     apps and SDKs fill with a codec's or a track's parameters, with or without a codec behind it. The launcher activity
     is the framework's own android.app.Activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mediaformat" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.mediaformat.MediaFormatApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
