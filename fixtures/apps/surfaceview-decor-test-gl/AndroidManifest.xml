<?xml version="1.0" encoding="utf-8"?>
<!-- The gl twin of surfaceview-decor-test (shared sources): the child SurfaceView posts its own first frame with a GL
     context (clear + swap) instead of the CPU, and keeps the producer. GLES is not required; the SurfaceView's surface
     has no prior producer, so GL is its sole producer. The opaque software decor around the hole must stay shown. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.surfaceviewdecorgl" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00020000" android:required="false"/>
  <application android:label="@string/app_name" android:hardwareAccelerated="false">
    <activity android:name="io.github.kisame76.minato.test.surfaceviewdecor.GlProducerActivity"
        android:exported="true" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
