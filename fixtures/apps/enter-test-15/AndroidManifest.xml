<?xml version="1.0" encoding="utf-8"?>
<!-- enter-test as an app of target SDK 15, before Jelly Bean, whose Enter and delete LatinIME sends as the ENTER and
     DEL keys. Android 15 installs it only with install's bypass of the low target SDK block. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.enter" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="15" android:targetSdkVersion="15"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.enter.EnterActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:windowSoftInputMode="stateHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name="io.github.kisame76.minato.test.enter.FixtureInputMethod" android:exported="true"
        android:label="@string/ime_name" android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod"/>
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
  </application>
</manifest>
