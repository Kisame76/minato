<?xml version="1.0" encoding="utf-8"?>
<!-- The black-screen probe (ADR-0043 amendment / ADR-0058 c): an engine's GL start-probe over a software surface.
     A full-screen plain SurfaceView, drawn in software (hardwareAccelerated="false"), posts one opaque CPU frame
     (lockCanvas / unlockCanvasAndPost) and then tries an EGL context and a window surface on the SAME surface and
     drops it, as SDL/Mono/Unity probe GL at start and fall back to software; the surface is never posted again.
     With the connect-state fix the EGL window surface is refused while the CPU producer holds the surface (no second
     producer, no drawable to hide the buffers' sublayer), so the CPU frame stays shown; without it the GL drawable
     hid it and the static surface went black. GLES is not required: the app runs in software when the probe is
     refused. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.eglprobedecor" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00020000" android:required="false"/>
  <application android:label="@string/app_name" android:hardwareAccelerated="false">
    <activity android:name="io.github.kisame76.minato.test.eglprobedecor.EglProbeActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
