<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0065's test of the device profiles (device-profile-test): an app that logs what android.os.Build says about its
     device. The label is the tag its lines carry; the values go under the tag with -device. The launcher activity is
     the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.devprofile" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="device-profile-test"
      android:name="io.github.kisame76.minato.test.devprofile.ProfileApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
