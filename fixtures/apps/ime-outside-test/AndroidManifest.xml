<?xml version="1.0" encoding="utf-8"?>
<!-- A tap outside a text field while the keyboard is up, for the text fields of game engines and app frameworks
     (ime-outside-test): whether the keyboard stays and whether the game under it gets the tap. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.imeoutside" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.imeoutside.OutsideActivity" android:exported="true"
        android:windowSoftInputMode="adjustNothing">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
