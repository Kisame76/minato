<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039's test 3 (config-test, b3.4c): the Application class logs the system Resources' DisplayMetrics and
     Configuration. The launcher activity is the framework's own android.app.Activity, so that `am start` starts the
     process on Android; step a's driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.config" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Config Test"
      android:name="io.github.kisame76.minato.test.config.ConfigApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
