<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0049's test 8 (obb-test): an app reads its main OBB from its OBB folder, where the user or a store put it, in
     Application.attachBaseContext. The OBB is main.1.io.github.kisame76.minato.test.obb.obb next to this manifest,
     a text of Minato's own. The launcher activity is the framework's own android.app.Activity, so that `am start`
     starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.obb" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="obb-test" android:name="io.github.kisame76.minato.test.obb.ObbApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
