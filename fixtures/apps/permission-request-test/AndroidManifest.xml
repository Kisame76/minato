<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0063's test of Activity.requestPermissions (permission-request-test), from the sources of
     fixtures/java/permission-request-test. The harness grants what the twin's name says (-fine: both location
     permissions, else none). The label is the tag its lines carry. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.permreq" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:label="permission-request-test">
    <activity android:name="io.github.kisame76.minato.test.permreq.PermissionRequestActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
