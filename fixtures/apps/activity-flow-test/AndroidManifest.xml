<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step b3.5b2-1's test (activity-flow-test): an app starts its own activities in its one task. The launcher,
     Splash, starts Main and finishes; Main starts Second, which finishes; then Main starts Third from the Application
     with FLAG_ACTIVITY_NEW_TASK, which joins the app's task, whose affinity it shares, and finishes. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.activityflow" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
      android:name="io.github.kisame76.minato.test.activityflow.FlowApplication">
    <activity android:name="io.github.kisame76.minato.test.activityflow.SplashActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name="io.github.kisame76.minato.test.activityflow.MainActivity" android:exported="false"/>
    <activity android:name="io.github.kisame76.minato.test.activityflow.SecondActivity" android:exported="false"/>
    <activity android:name="io.github.kisame76.minato.test.activityflow.ThirdActivity" android:exported="false"/>
  </application>
</manifest>
