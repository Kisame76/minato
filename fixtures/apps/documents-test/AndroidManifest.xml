<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0057 step b's test (documents-test): an app opens a document with the system picker and reads what the
     picker gives: the URI, the grant, the provider's columns, type and bytes, and the persisted grants. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.documents" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".DocumentsActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
