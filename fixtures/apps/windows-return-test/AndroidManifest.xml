<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the windows at the background and the return (windows-return-test; ADR-0041 gap 4 (b5a)): a dialog
     with a popup on its button over the launcher activity, and a translucent activity with a SurfaceView above them,
     through HOME and the return. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.windowsreturn" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name="io.github.kisame76.minato.test.windowsreturn.ReturnActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name="io.github.kisame76.minato.test.windowsreturn.ReturnTranslucentActivity"
        android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
  </application>
</manifest>
