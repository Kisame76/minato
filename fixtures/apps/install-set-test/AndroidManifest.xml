<?xml version="1.0" encoding="utf-8"?>
<!-- An app installer that hands a split set to one PackageInstaller session, as SAI does: the base APK, the feature
     split and the arm64 and language splits of splits-test (tools/build-splits-test.sh, packed into this app's assets by tools/build-java-test-app.sh).
     Android takes the set and asks the user (STATUS_PENDING_USER_ACTION). The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.installset" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.installset.SetApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
