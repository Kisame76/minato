<?xml version="1.0" encoding="utf-8"?>
<!-- Framework breadth F4f's test (f4f-media-route-test): android.media's routing data as a media app builds and reads
     it (routes, routing sessions, discovery and listing preferences), and the recorder's encoder profiles. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mediaroute" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".RouteActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
