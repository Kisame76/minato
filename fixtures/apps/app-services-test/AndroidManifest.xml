<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the app's own started services (app-services-test, ADR-0045 step SV2): startService,
     startForegroundService, stopService, stopSelf and stopSelfResult, startForeground and stopForeground, each
     service made through the app's AppComponentFactory and called on the main thread. A service with an intent filter,
     a disabled one, a foreground one of type dataSync and one without a type. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.appservices" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.appservices.AppServicesApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name=".CountingService" android:exported="false">
      <intent-filter>
        <action android:name="io.github.kisame76.minato.test.appservices.COUNT"/>
      </intent-filter>
    </service>
    <service android:name=".OffService" android:enabled="false" android:exported="false"/>
    <service android:name=".SyncService" android:exported="false" android:foregroundServiceType="dataSync"/>
    <service android:name=".PlainService" android:exported="false"/>
  </application>
</manifest>
