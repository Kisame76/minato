<?xml version="1.0" encoding="utf-8"?>
<!-- The compatibility plan's gap 21 test (timezone-test): the time zone data an app reads, the tzdata module's files
     as Android 15 lays them out, and what java.util.TimeZone, java.time, ICU and the date formats answer from them for
     fixed instants in zones with and without daylight saving time. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.timezone" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="timezone-test">
    <activity android:name="io.github.kisame76.minato.test.timezone.TimezoneActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
