<?xml version="1.0" encoding="utf-8"?>
<!-- audio-input-test-granted (ADR-0064), the twin of audio-input-test, from its sources: a NativeActivity through
     native_app_glue on AAudio input streams and OpenSL ES recorders, packed by make-apk. The harness grants
     RECORD_AUDIO before the start. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.audioinputgranted"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <application android:label="Audio Input Test Granted" android:hasCode="false"
      android:extractNativeLibs="false">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="audio-input-test-granted"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
