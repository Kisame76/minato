<?xml version="1.0" encoding="utf-8"?>
<!-- present-limit-vulkan (ADR-0078 decision 4): present-limit-test's library as a copy of its own, started at
     ANativeActivity_onCreateVulkan, which presents with a FIFO swapchain in a loop, without pacing of its own. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.presentlimit.vulkan"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true"/>
  <application android:label="Present Limit Vulkan" android:hasCode="false"
      android:extractNativeLibs="false">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="present-limit-vulkan"/>
      <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreateVulkan"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
