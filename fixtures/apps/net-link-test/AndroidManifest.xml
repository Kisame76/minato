<?xml version="1.0" encoding="utf-8"?>
<!-- The link properties test (net-link-test): the Application reads what
     ConnectivityManager.getLinkProperties(getActiveNetwork()) hands out on the host's network (its interface,
     addresses, routes, DNS servers and MTU) and logs its structure, not its values: the values differ by network and
     device. The launcher activity is the framework's own android.app.Activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.netlink" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <application android:label="net-link-test" android:name="io.github.kisame76.minato.test.netlink.LinkApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
