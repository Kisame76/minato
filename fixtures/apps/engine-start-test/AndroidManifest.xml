<?xml version="1.0" encoding="utf-8"?>
<!-- engine-start-test: what a game engine's player asks of EGL, GLES and the Java display at its start (contexts asked
     from ES 3.2 down, shared contexts, frame timestamps, a frame pacer's fence wait and
     display timing, a class of the APK through the activity's class loader); see its jni folder. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.enginestart" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <application android:label="Engine Start Test">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="engine-start-test"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
