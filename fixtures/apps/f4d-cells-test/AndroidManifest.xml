<?xml version="1.0" encoding="utf-8"?>
<!-- Framework breadth F4d's test (f4d-cells-test): the telephony cell family, as an SDK reads it: cells of every radio
     technology built from their parcels and read back, the lists TelephonyManager returns, and the small data types
     around them (thresholds, radio access specifiers, neighboring cells). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.cells" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".CellsActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
