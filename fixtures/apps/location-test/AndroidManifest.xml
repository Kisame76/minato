<?xml version="1.0" encoding="utf-8"?>
<!-- The test of android.location.Location and LocationListener (location-test), which Unity's player looks up at its
     first frame (the Unity test APK probe's blocker 12): a location's fields and arithmetic, and a listener's default methods.
     The app holds no location permission and asks for no provider. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.location" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.location.LocationApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
