<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the intents that leave the app for iOS, started (open-start-test; ADR-0062): an app that handles none
     of them starts each for a result. Runtime-only: on Android each would open an app of the emulator. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.openstart" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".OpenStartActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <provider android:name=".SharedFiles" android:authorities="io.github.kisame76.minato.test.openstart.files"
        android:exported="false" android:grantUriPermissions="true"/>
  </application>
</manifest>
