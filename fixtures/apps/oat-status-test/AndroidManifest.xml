<?xml version="1.0" encoding="utf-8"?>
<!-- M6 c1's test of the odex next to an APK (oat-status-test): an app that asks ART whether its own dex file is up to
     date. The label is the tag its lines carry. The launcher activity is the framework's own android.app.Activity, so
     that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.oatstatus" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="oat-status-test"
      android:name="io.github.kisame76.minato.test.oatstatus.StatusApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
