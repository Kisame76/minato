<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@+id/on" android:state_checked="true" android:drawable="@drawable/square_blue"/>
  <item android:id="@+id/off" android:drawable="@drawable/square_green"/>
  <transition android:fromId="@id/off" android:toId="@id/on" android:drawable="@drawable/animation_list"/>
</animated-selector>
