<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0041 a)'s test of GLES from Java (gles-java-test): EGL10 as Godot's GLSurfaceView uses it, EGL14 with GLES20
     and GLES30, and GL10 on an ES 1.1 context, all on pbuffers. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.glesjava" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <application android:label="GLES Java Test"
      android:name="io.github.kisame76.minato.test.glesjava.GlesJavaApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
