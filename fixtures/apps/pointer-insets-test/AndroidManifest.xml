<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0042 b (pointer-insets-test): the Application class asks PointerIcon for system and custom
     icons, loads its own <pointer-icon>, and drives a WindowInsetsAnimation, its Bounds and a Callback, as Godot's
     views do, and logs what each answers, without a window. The launcher activity is the framework's own
     android.app.Activity, as in drawables-test; the driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.pointerinsets" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Pointer Insets Test"
      android:name="io.github.kisame76.minato.test.pointerinsets.PointerInsetsApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
