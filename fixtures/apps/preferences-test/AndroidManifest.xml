<?xml version="1.0" encoding="utf-8"?>
<!-- The test of android.preference (preferences-test; framework breadth, step (c)): the defaults an XML tree of every
     preference type writes into the default SharedPreferences, and the types' own state and arithmetic. The launcher
     activity is the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.preferences" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="preferences-test" android:name="io.github.kisame76.minato.test.preferences.PreferencesApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
