<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0058 d)'s test of TextureView (texture-view-test): two TextureViews in a hardware accelerated window, as an
     app's window is on Android, fed by lockCanvas; the second with a transform. The listener's calls, getBitmap's
     pixels and the screen's pixels where the views are. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.textureview" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.textureview.TextureViewActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
