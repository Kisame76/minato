<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c2c3's test (activity-start-test): an app's own Activity subclass starts as the launcher, behind an
     activity-alias, on a theme without an action bar, and its window shows its content view. A provider and the
     Application's lifecycle callbacks show where the start falls among the app's own steps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.activitystart" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.activitystart.StartApplication">
    <activity android:name="io.github.kisame76.minato.test.activitystart.StartActivity" android:exported="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>
    <!-- Ahead of Launcher, three filters a home screen's launch intent does not match: MAIN without LAUNCHER, MAIN
         and LAUNCHER with a scheme, and a disabled alias (step c2c3.1). Android lists none of them as a launcher. -->
    <activity-alias android:name="io.github.kisame76.minato.test.activitystart.MainOnly" android:exported="true"
        android:targetActivity="io.github.kisame76.minato.test.activitystart.StartActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="io.github.kisame76.minato.test.activitystart.WithData" android:exported="true"
        android:targetActivity="io.github.kisame76.minato.test.activitystart.StartActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
        <data android:scheme="https"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="io.github.kisame76.minato.test.activitystart.Disabled" android:exported="true"
        android:enabled="false"
        android:targetActivity="io.github.kisame76.minato.test.activitystart.StartActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="io.github.kisame76.minato.test.activitystart.Launcher" android:exported="true"
        android:targetActivity="io.github.kisame76.minato.test.activitystart.StartActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <provider android:name="io.github.kisame76.minato.test.activitystart.StartProvider"
        android:authorities="io.github.kisame76.minato.test.activitystart.provider" android:exported="false"/>
  </application>
</manifest>
