<?xml version="1.0" encoding="utf-8"?>
<!-- The test of TrafficStats (traffic-test): the thread's tag and uid, the socket tagger that the app process attaches
     at its start, with StrictMode's untagged socket violation, tagging sockets and descriptors, the counters Android
     answers UNSUPPORTED for, and incrementOperationCount's checks. Sockets need INTERNET on Android. The launcher
     activity is the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.traffic" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.traffic.TrafficApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
