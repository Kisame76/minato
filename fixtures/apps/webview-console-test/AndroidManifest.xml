<?xml version="1.0" encoding="utf-8"?>
<!-- A page's console messages (webview-console-test, ADR-0056 c3): an asset page logs at each level and throws; with
     no WebChromeClient, then one whose onConsoleMessage returns false, Android logs them under the tag chromium, and
     with one that returns true it does not. No network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.webviewconsole" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name="io.github.kisame76.minato.test.webviewconsole.ConsoleActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
