<?xml version="1.0" encoding="utf-8"?>
<!-- The test of BiometricPrompt, BiometricManager and FingerprintManager on a device that the app finds without a usable
     biometric (batch G): the prompt's builder and getters, the crypto objects, canAuthenticate's answers and the error
     an authentication ends in. The iPhone has no biometric sensor an Android app can use (ADR-0045 decision 4), where
     the emulator has an emulated one, so those lines are only shown (tag biometric-test-device). The launcher activity is
     the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.biometric" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.biometric.BiometricApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
