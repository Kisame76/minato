<?xml version="1.0" encoding="utf-8"?>
<!-- Data Saver as an app sees it (restrict-background-test, ADR-0054 step d)): ConnectivityManager's restrict-background
     status and ACTION_RESTRICT_BACKGROUND_CHANGED while the system turns Data Saver on and off again, which Minato
     takes from the iPhone's Low Data Mode. No connection is made. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.restrictbackground" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name="io.github.kisame76.minato.test.restrictbackground.RestrictActivity"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
