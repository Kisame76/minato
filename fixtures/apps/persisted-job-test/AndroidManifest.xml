<?xml version="1.0" encoding="utf-8"?>
<!-- The test of persisted jobs (persisted-job-test; the compatibility plan's decision 6): a job scheduled with
     setPersisted(true) is still there when the app starts again, and one that is not persisted may be gone. The job
     service is the app's own and is never meant to run (the jobs wait a minute). The app holds
     RECEIVE_BOOT_COMPLETED, which a persisted job needs. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.persist" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.persist.PersistApplication">
    <service android:name="io.github.kisame76.minato.test.persist.NeverJob"
        android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false"/>
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
