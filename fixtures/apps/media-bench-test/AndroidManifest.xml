<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0060 e2c's iPhone measurement (media-bench-test): MediaCodec's H.264 decoder at 1080p and 4K on Minato's own
     streams (assets/, from tools/make-h264-sample.sh with its bench option), through the NDK's AMediaCodec in the app's JNI library,
     and the decoder across the background. The launcher activity is the framework's own android.app.Activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mediabench" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
  <application android:label="Media Bench Test"
      android:name="io.github.kisame76.minato.test.mediabench.MediaBenchApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
