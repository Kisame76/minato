<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0060 e2e's test (media-player-test): android.media.MediaPlayer on Minato's own baseline.mp4 (res/raw, from
     tools/make-mp4-sample.sh), with the INTERNET permission and the default network security config, so that http
     is cleartext refused as from targetSdk 28. The launcher activity is the framework's own android.app.Activity, so
     that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mediaplayer" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.mediaplayer.MediaPlayerApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
