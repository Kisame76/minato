<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0058 e1)'s test of ImageWriter (image-writer-test, the graphics breadth's G3b): writers on ImageReaders and on
     a SurfaceTexture, the images an app writes and queues, onImageReleased, maxImages, a dequeue while the reader
     holds its images, and a reader's image queued into a writer. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.imagewriter" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35"/>
  <application android:label="ImageWriter Test"
      android:name="io.github.kisame76.minato.test.imagewriter.ImageWriterApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
