<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c5.1's test (jni-lib-test): the app's JNI library where Android's installer puts it, the code path's
     lib/arm64, which ApplicationInfo.nativeLibraryDir names: what the class loader's findLibrary answers, the file
     there, and what the library answers after System.loadLibrary. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.jnilib" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="JNI Lib Test"
      android:name="io.github.kisame76.minato.test.jnilib.JniLibApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
