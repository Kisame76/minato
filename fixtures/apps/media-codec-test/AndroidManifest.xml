<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0060 e2b's Java test (media-codec-test): MediaCodec's H.264 decoder in ByteBuffer mode on Minato's own
     streams (assets/, from tools/make-h264-sample.sh), in Java and through the NDK's AMediaCodec in the app's JNI
     library. The launcher activity is the framework's own android.app.Activity, so that `am start` starts the process
     on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mediacodec" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
  <application android:label="Media Codec Test"
      android:name="io.github.kisame76.minato.test.mediacodec.MediaCodecApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
