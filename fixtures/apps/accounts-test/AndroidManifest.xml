<?xml version="1.0" encoding="utf-8"?>
<!-- The test of android.accounts (accounts-test; retest 8's resolve list, batch B2): AccountManager as an app that
     holds no account permission and has no account sees it, its futures and listeners, and what it refuses. The
     launcher activity is the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.accounts" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="accounts-test" android:name="io.github.kisame76.minato.test.accounts.AccountsApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
