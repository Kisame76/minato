<?xml version="1.0" encoding="utf-8"?>
<!-- The test of reflection over framework classes (view-fields-test): the declared fields of the classes the engines walk
     (View, ViewGroup, FrameLayout, TextView, ...), as Unity's ReflectionHelper.getFieldID does along a view's superclasses
     (the Unity test APK probe: a field whose type is missing makes getDeclaredFields throw). The launcher activity is the
     framework's own android.app.Activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.viewfields" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.viewfields.ViewFieldsApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
