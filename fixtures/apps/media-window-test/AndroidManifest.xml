<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0060 e2c3's Java test (media-window-test): MediaCodec's H.264 decoder rendering into a SurfaceView's window,
     on Minato's own baseline stream (assets/, media-codec-test's, from tools/make-h264-sample.sh), in Java and through
     the NDK's AMediaCodec in the app's JNI library. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mediawindow" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
  <application android:label="Media Window Test">
    <activity android:name="io.github.kisame76.minato.test.mediawindow.WindowActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
