<?xml version="1.0" encoding="utf-8"?>
<!-- Framework breadth F4a's test (f4a-components-test): the base classes an app declares in its manifest, as the app
     the user installs would: a DocumentsProvider and a SearchRecentSuggestionsProvider made at the app's start, an
     AppWidgetProvider, a DelegatedAdminReceiver and a RestrictionsReceiver, and a CameraPrewarmService. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.components" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="30"/>
  <application android:label="@string/app_name">
    <activity android:name=".ComponentsActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <provider android:name=".DocsProvider" android:authorities="io.github.kisame76.minato.test.components.docs"
        android:exported="true" android:grantUriPermissions="true"
        android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
      </intent-filter>
    </provider>
    <provider android:name=".SuggestProvider"
        android:authorities="io.github.kisame76.minato.test.components.suggest" android:exported="false"/>
    <receiver android:name=".WidgetReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info"/>
    </receiver>
    <receiver android:name=".AdminReceiver" android:exported="false"/>
    <receiver android:name=".RestrictReceiver" android:exported="false"/>
    <service android:name=".PrewarmService" android:exported="false"/>
  </application>
</manifest>
