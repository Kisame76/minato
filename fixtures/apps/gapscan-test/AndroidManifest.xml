<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the gap scanner (gapscan-test): GapScan reads the ID tables and class definitions of an APK's
     classes*.dex and says which platform classes, methods and fields the running boot classpath lacks. The test scans a
     dex made on the spot and its own APK. The launcher activity is the framework's own android.app.Activity, so that
     `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.gapscan" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="gapscan-test"
      android:name="io.github.kisame76.minato.test.gapscan.GapScanApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
