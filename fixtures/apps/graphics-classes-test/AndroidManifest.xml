<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the graphics classes whose natives work on a CPU canvas (graphics-classes-test): BitmapRegionDecoder,
     Gainmap, AnimatedImageDrawable and Mesh with MeshSpecification, each used as an app uses it.
     The launcher activity is the framework's own android.app.Activity, so that `am start` starts the process on
     Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.graphicsclasses" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.graphicsclasses.GraphicsClassesApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
