<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0057 step d's folder test (documents-tree-test): an app opens Documents with the system's folder picker, as
     a game that keeps its saves there does, makes a file in it, and reads it again at its next start through the
     grant it kept. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.documentstree" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".DocumentsTreeActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
