<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0057 step b's restart test (documents-restart-test): an app keeps one picked document and not another; at its
     next start the kept grant still reads and the other is gone, with its clone. Minato only: nothing on Android
     deletes a picked file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.documentsrestart" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".RestartActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
