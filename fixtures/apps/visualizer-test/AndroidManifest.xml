<?xml version="1.0" encoding="utf-8"?>
<!-- The test of android.media.audiofx.Visualizer (visualizer-test): a Visualizer on a track's session and on the output
     mix, its capture sizes, rates, modes, waveform and FFT, and what it does without RECORD_AUDIO. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.visualizer" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.visualizer.VisualizerApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
