<?xml version="1.0" encoding="utf-8"?>
<!-- Frames at the background (background-frame-test): a postFrameCallback loop and a layout requested at onPause,
     through HOME and the return. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.backgroundframe" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name="io.github.kisame76.minato.test.backgroundframe.FrameActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
