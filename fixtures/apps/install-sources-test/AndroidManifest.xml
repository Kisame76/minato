<?xml version="1.0" encoding="utf-8"?>
<!-- The test of an app that wants to install apps: it asks canRequestPackageInstalls, finds the settings page for
     unknown app sources, and sees the result (the app's own state only; the dialog is the host's). The launcher
     activity is the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.installsources" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.installsources.SourcesApplication">
    <provider android:name="io.github.kisame76.minato.test.installsources.ApkProvider"
        android:authorities="io.github.kisame76.minato.test.installsources.files" android:exported="false"/>
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
