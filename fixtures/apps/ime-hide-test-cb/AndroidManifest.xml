<?xml version="1.0" encoding="utf-8"?>
<!-- ime-hide-test-cb: ime-hide-test's twin that opted in to OnBackInvokedCallback (ADR-0068, the keyboard
     reopen bug): two engine-style fields that track the soft keyboard themselves, one by onKeyPreIme(BACK) and one by
     the IME inset. Its fixture input method has a keyboard of a fixed height and types nothing. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.imehide" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:enableOnBackInvokedCallback="true">
    <activity android:name="io.github.kisame76.minato.test.imehide.HideActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name="io.github.kisame76.minato.test.imehide.FixtureInputMethod" android:exported="true"
        android:label="@string/ime_name" android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod"/>
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
  </application>
</manifest>
