<?xml version="1.0" encoding="utf-8"?>
<!-- gles-procs-test (graphics/tests/gles_procs_test.c) as a NativeActivity through native_app_glue, packed by
     make-apk, so that it runs in an app session on the iPhone: which GLES, EGL and Vulkan functions an app finds,
     against Android 15's measurement. GLES and Vulkan are not required, as the test only looks them up. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.glesprocs"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="GLES Procs Test" android:hasCode="false"
      android:extractNativeLibs="false">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="gles-procs-test"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
