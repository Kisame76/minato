<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0073 step e's test of the legacy android.hardware.Camera (camera-legacy-test), with CAMERA, which the harness
     grants before the start: the cameras, their parameters and the answers of the API around them, as every
     Android 15 camera gives them. The launcher activity is the framework's own android.app.Activity, so that
     `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.cameralegacy" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <application android:label="Camera Legacy Test"
      android:name="io.github.kisame76.minato.test.cameralegacy.LegacyApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
