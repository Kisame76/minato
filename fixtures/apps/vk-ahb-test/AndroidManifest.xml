<?xml version="1.0" encoding="utf-8"?>
<!-- vk-ahb-test (ADR-0058 e1), decision 7): graphics/tests/vk_ahb_test.c as a NativeActivity through native_app_glue,
     packed by make-apk, so that it runs in an app session on the iPhone with MoltenVK and the hardware buffers. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.vkahb"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true"/>
  <application android:label="Vulkan AHB Test" android:hasCode="false"
      android:extractNativeLibs="false">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="vk-ahb-test"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
