<?xml version="1.0" encoding="utf-8"?>
<!-- ime-probe-test (the Android reference for the Ren'Py name dialog): only a fixture input method that logs, under
     the tag ime-probe, what it is told about the field of any app: the editor info, when input starts, shows, hides
     and ends, and what the field answers to getExtractedText. tools/renpy-input-reference.sh installs and selects
     it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.imeprobe" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <service android:name="io.github.kisame76.minato.test.imeprobe.ProbeInputMethod" android:exported="true"
        android:label="@string/ime_name" android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod"/>
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
  </application>
</manifest>
