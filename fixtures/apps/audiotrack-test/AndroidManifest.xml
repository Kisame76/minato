<?xml version="1.0" encoding="utf-8"?>
<!-- The test of android.media.AudioTrack (audiotrack-test; the Unity test APK probe: FMOD's output thread): tracks built with
     each constructor and the Builder, their checks and states, streaming writes that block, return short or fail, and a
     static clip. The launcher activity is the framework's own android.app.Activity, so that `am start` starts the
     process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.audiotrack" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.audiotrack.AudioTrackApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
