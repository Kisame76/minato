<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the main thread's Looper under posts from other threads (main-looper-test): the Unity test APK's retests showed
     Runnables posted to the main Looper running seconds late. The launcher activity is the framework's own
     android.app.Activity, so that the main thread draws frames meanwhile, as an app's does. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mainlooper" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.mainlooper.MainLooperApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
