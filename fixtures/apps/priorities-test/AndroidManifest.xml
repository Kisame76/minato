<?xml version="1.0" encoding="utf-8"?>
<!-- The test of a thread's priority (priorities-test): Process.setThreadPriority and getThreadPriority for the
     caller, another thread and an unknown one, a HandlerThread's priority, and the nice values that ART gives a Java
     thread's priority at Thread.setPriority and at the thread's start. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.priorities" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.priorities.PrioritiesApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
