<?xml version="1.0" encoding="utf-8"?>
<!-- gles-live (ADR-0032, test 8; ADR-0036 a): gles-test's library as a copy of its own, started at
     ANativeActivity_onCreateLive, which draws a frame per AChoreographer callback until onDestroy. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.gles.live"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <application android:label="GLES Live" android:hasCode="false"
      android:extractNativeLibs="false">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="gles-live"/>
      <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreateLive"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
