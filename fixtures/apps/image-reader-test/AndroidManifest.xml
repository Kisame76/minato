<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0058 e1)'s test of ImageReader (image-reader-test, the graphics breadth's G3a): readers of RGBA_8888, RGB_565
     and PRIVATE fed by Canvas and GL producers through their surfaces, the images' planes, timestamps and hardware
     buffers, maxImages and acquireLatestImage. The launcher activity is the framework's own android.app.Activity, so
     that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.imagereader" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00020000" android:required="true"/>
  <application android:label="ImageReader Test"
      android:name="io.github.kisame76.minato.test.imagereader.ImageReaderApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
