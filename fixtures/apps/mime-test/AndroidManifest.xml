<?xml version="1.0" encoding="utf-8"?>
<!-- The test of android.webkit.MimeTypeMap and android.webkit.URLUtil (mime-test; retest 8's resolve list, batch B1): the
     table that maps file extensions to MIME types and back, and the file names and URLs that URLUtil derives. The
     launcher activity is the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mime" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="mime-test" android:name="io.github.kisame76.minato.test.mime.MimeApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
