<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0043 d2's test of android.os.Parcel (parcel-test): AOSP's Parcel.java over Minato's natives, whose bytes and
     answers it logs. The launcher activity is the framework's own android.app.Activity, so that `am start` starts the
     process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.parcel" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Parcel Test"
      android:name="io.github.kisame76.minato.test.parcel.ParcelApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
