<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0041 a5's test (jnigraphics-test): the app's own JNI library links the NDK's libjnigraphics, reads Java
     bitmaps through AndroidBitmap_* and decodes the APK's picture.png through AImageDecoder. The launcher activity is
     the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.jnigraphics" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Jnigraphics Test"
      android:name="io.github.kisame76.minato.test.jnigraphics.JnigraphicsApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
