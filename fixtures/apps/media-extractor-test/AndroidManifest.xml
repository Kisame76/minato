<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0060 e2d's test (media-extractor-test): the NDK's AMediaExtractor on Minato's own mp4 files (assets/, from
     tools/make-mp4-sample.sh) in the app's JNI library. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.mediaextractor" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35"/>
  <application android:label="Media Extractor Test"
      android:name="io.github.kisame76.minato.test.mediaextractor.MediaExtractorApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
