<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0043 step f) (palette-test): the Application class logs every public system color as the app's Resources and
     the system's give it, with the colors of Monet's overlays, and a TextView's default colors. The launcher activity
     is the framework's own android.app.Activity, as in app-start-test; the driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.palette" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Palette Test"
      android:name="io.github.kisame76.minato.test.palette.PaletteApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
