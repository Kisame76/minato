<?xml version="1.0" encoding="utf-8"?>
<!-- trim-memory-test (the memory-warning step): the callbacks of ComponentCallbacks2 that the system calls when it trims
     an app's memory, in the order it calls them: the Application, an activity, a provider and a callback an app
     registered itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.trimmemory" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.trimmemory.TrimApplication">
    <provider android:name="io.github.kisame76.minato.test.trimmemory.TrimProvider"
        android:authorities="io.github.kisame76.minato.test.trimmemory" android:exported="false"/>
    <activity android:name="io.github.kisame76.minato.test.trimmemory.TrimActivity" android:exported="true"
        android:label="@string/app_name">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
