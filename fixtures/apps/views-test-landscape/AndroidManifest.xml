<?xml version="1.0" encoding="utf-8"?>
<!-- The twin of views-test (ADR-0043's test 1) in landscape: the same sources (fixtures/java/views-test), its activity
     with screenOrientation="landscape", as many apps and games ask, so that the session turns its window at the start
     while the window draws in software. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.viewslandscape" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:hardwareAccelerated="false">
    <activity android:name="io.github.kisame76.minato.test.views.ViewsActivity" android:exported="true"
        android:screenOrientation="landscape" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
