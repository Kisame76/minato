<?xml version="1.0" encoding="utf-8"?>
<!-- A splash, then a WebView (webview-splash-test, ADR-0056): the launcher activity shows a splash and then puts a
     WebView in its place; after the page a second activity shows a WebView of its own. No network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.webviewsplash" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name="io.github.kisame76.minato.test.webviewsplash.SplashActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name="io.github.kisame76.minato.test.webviewsplash.PageActivity" android:exported="false"/>
  </application>
</manifest>
