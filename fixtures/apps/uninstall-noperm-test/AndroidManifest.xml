<?xml version="1.0" encoding="utf-8"?>
<!-- The same app as uninstall-test, without REQUEST_DELETE_PACKAGES in its manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.uninstallnoperm" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.uninstallnoperm.UninstallApplication">
    <activity android:name="io.github.kisame76.minato.test.uninstallnoperm.UninstallActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
