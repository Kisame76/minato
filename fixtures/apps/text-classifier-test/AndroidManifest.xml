<?xml version="1.0" encoding="utf-8"?>
<!-- The test of TextClassificationManager (text-classifier-test; the compatibility plan's decision 6): the manager an
     app gets, the classifier it returns and what that classifier answers for a URL, a phone number and a selection.
     The launcher activity is the framework's own android.app.Activity, so that `am start` starts the process on
     Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.textclassifier" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.textclassifier.ClassifierApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
