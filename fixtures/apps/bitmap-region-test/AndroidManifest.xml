<?xml version="1.0" encoding="utf-8"?>
<!-- A tiled image viewer's calls (bitmap-region-test): BitmapRegionDecoder over a PNG and a JPEG that the app makes, each
     from bytes, a stream, a file path and a file descriptor, with regions of all four quadrants at three sample sizes, a
     16-bit config, a region partly outside the image and one wholly outside it. The launcher activity is the framework's
     own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.bitmapregion" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.bitmapregion.RegionApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
