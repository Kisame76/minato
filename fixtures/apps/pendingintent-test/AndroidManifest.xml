<?xml version="1.0" encoding="utf-8"?>
<!-- The test of PendingIntents (pendingintent-test; ADR-0045 step d3, batch D 3: AlarmManager and WorkManager hand
     the system PendingIntents): their identity, the flags that make, find, update and cancel them, their creator, and
     sending broadcasts through them to a receiver the app registers. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.pendingintent" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.pendingintent.PendingIntentApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
