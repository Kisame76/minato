<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0043 step d)'s test (text-test): an EditText made as Godot makes its GodotEditText, beside a TextView, set up,
     typed into as an input method types, and measured; and what the input method manager answers on a device without
     an input method. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.text" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.text.TextActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
