<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0068 step 7c2's test of a hardware keyboard (keyboard-test): the host adds a keyboard to the session's input
     devices and types on it, and removes it. Minato's own lines, as the AVD's keyboard has its own map. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.keyboard" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Keyboard Test"
      android:name="io.github.kisame76.minato.test.keyboard.KeyboardApplication">
    <activity android:name="io.github.kisame76.minato.test.keyboard.KeyboardActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
