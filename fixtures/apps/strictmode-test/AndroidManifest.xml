<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c2d3 (strictmode-test): the Application class logs StrictMode's start policies, Build.getSerial,
     a name lookup on the main thread, setVmPolicy and enableDefaults, without a window. The launcher activity is the
     framework's own android.app.Activity, as in drawables-test; the driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.strictmode" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="StrictMode Test"
      android:name="io.github.kisame76.minato.test.strictmode.StrictModeApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
