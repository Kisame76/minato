<?xml version="1.0" encoding="utf-8"?>
<!-- Hypothesis 2 variant of the black-screen sweep: a window with android:windowBackground="@null", so the decor
     posts no background of its own and the content view (an opaque colour, drawn in software) alone provides the
     pixels. That opaque content must stay shown; a window that treated the missing background as nothing to show would
     go black. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.nullbackgrounddecor" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:hardwareAccelerated="false">
    <activity android:name="io.github.kisame76.minato.test.nullbackgrounddecor.NullBackgroundActivity"
        android:exported="true" android:theme="@style/NoBackground">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
