<?xml version="1.0" encoding="utf-8"?>
<!-- program-binary-test: GL program binaries across two starts, as a game engine's shader cache uses them (the first
     start saves them, the second loads them, and binaries a driver must refuse); see its jni folder. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.programbinary" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <application android:label="Program Binary Test"
      android:name="io.github.kisame76.minato.test.programbinary.ProgramBinaryApplication">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="program-binary-test"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
