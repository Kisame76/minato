<?xml version="1.0" encoding="utf-8"?>
<!-- Framework breadth F4g's test (f4g-audio-patch-test): what a recording app reads of the audio system's recordings
     and ports (ADR-0064 step 1): AudioRecordingConfiguration, the recording callbacks, and the audio port classes. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.audiopatch" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".AudioPatchActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
