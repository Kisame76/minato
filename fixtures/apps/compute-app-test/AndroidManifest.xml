<?xml version="1.0" encoding="utf-8"?>
<!-- M6 c's compiled-code measure of an app (compute-app-test): the Application runs compute-bench's loops in onCreate and
     logs their checksums. The launcher activity is the framework's own android.app.Activity, so that `am start` starts the
     process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.computeapp" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Compute App Test"
      android:name="io.github.kisame76.minato.test.computeapp.ComputeApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
