<?xml version="1.0" encoding="utf-8"?>
<!-- Framework breadth F4e's test (f4e-camera-session-test): camera2's session data, as an app builds it without a
     camera: output configurations, dynamic range profiles, an extension session's configuration, and the types that
     only CameraCharacteristics makes. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.camerasession" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name=".CameraSessionActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
