<?xml version="1.0" encoding="utf-8"?>
<!-- An app that installs through a PackageInstaller session: a broken APK is refused at once (STATUS_FAILURE_INVALID),
     a valid one (the app's own, as an update) asks the user (STATUS_PENDING_USER_ACTION with the confirm intent). The
     launcher activity is the framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.installsession" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.installsession.SessionApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
