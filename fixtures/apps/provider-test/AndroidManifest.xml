<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c2c1's test (provider-test): the app's components without the window. Its own AppComponentFactory
     overrides the five instantiate methods as androidx's CoreComponentFactory does. Of its four providers, the two of
     the main process that are enabled install before Application.onCreate, by initOrder; the one of :remote and the
     disabled one do not. The launcher activity is the framework's own android.app.Activity, so that `am start`
     starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.provider" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.provider.ProviderApplication"
      android:appComponentFactory="io.github.kisame76.minato.test.provider.TestComponentFactory">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <provider android:name="io.github.kisame76.minato.test.provider.FirstProvider"
        android:authorities="io.github.kisame76.minato.test.provider.first" android:exported="false"
        android:initOrder="5"/>
    <provider android:name="io.github.kisame76.minato.test.provider.SecondProvider"
        android:exported="true" android:initOrder="10"
        android:authorities="io.github.kisame76.minato.test.provider.second;minato.provider-test.alias">
      <meta-data android:name="io.github.kisame76.minato.test.provider.KEY" android:value="startup"/>
    </provider>
    <provider android:name="io.github.kisame76.minato.test.provider.RemoteProvider"
        android:authorities="io.github.kisame76.minato.test.provider.remote" android:process=":remote"
        android:exported="false"/>
    <provider android:name="io.github.kisame76.minato.test.provider.DisabledProvider"
        android:authorities="io.github.kisame76.minato.test.provider.disabled" android:enabled="false"
        android:exported="false"/>
  </application>
</manifest>
