<?xml version="1.0" encoding="utf-8"?>
<!-- ime-surrounding-test-return: ime-surrounding-test's field, which hides the keyboard at Enter as SDL2 does with
     SDL_HINT_RETURN_KEY_HIDES_IME (SDLInputConnection's ENTER, then hideSoftInputFromWindow), as Ren'Py's name field
     does at Return; and, for the Android reference only, the fixture input method that types and presses Enter. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.imesurroundingreturn" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.imesurrounding.SurroundingActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:windowSoftInputMode="stateHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name="io.github.kisame76.minato.test.imesurrounding.FixtureInputMethod" android:exported="true"
        android:label="@string/ime_name" android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod"/>
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
  </application>
</manifest>
