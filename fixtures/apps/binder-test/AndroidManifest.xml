<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0043 step d2b) (binder-test): the Application class makes the app's own binders, a local one, an AIDL-style
     stub with its proxy and an IBinder of its own, sends results through ResultReceivers and logs what each answers,
     without a window. The launcher activity is the framework's own android.app.Activity, as in drawables-test; the
     driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.binder" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Binder Test"
      android:name="io.github.kisame76.minato.test.binder.BinderApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
