<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the alarm manager (alarm-test; ADR-0045's alarms, kept and never run, batch D 3): AOSP's AlarmManager
     over the local alarm service, as an app without the exact alarm permissions meets it. The alarms lie a day ahead
     and are cancelled at the end, so that none goes off on Android either. The launcher activity is the framework's
     own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.alarm" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.alarm.AlarmApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
