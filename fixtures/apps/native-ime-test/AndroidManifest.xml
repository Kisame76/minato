<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0068 step 2e's test (native-ime-test): a NativeActivity that asks for the soft keyboard with
     ANativeActivity_showSoftInput and logs the key events its input queue gets, and, for the Android reference only,
     the fixture input method that types into it. Minato's activity-host runs no Java: its host posts the same calls
     as text records. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.nativeime" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="android.app.NativeActivity" android:exported="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <meta-data android:name="android.app.lib_name" android:value="native-ime-test"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name="io.github.kisame76.minato.test.nativeime.FixtureInputMethod" android:exported="true"
        android:label="@string/ime_name" android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod"/>
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
  </application>
</manifest>
