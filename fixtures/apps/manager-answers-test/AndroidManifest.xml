<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the most-called manager methods that Minato had no answer for (manager-answers-test; the
     compatibility plan's decision 6): ActivityManager, AppOpsManager, TelephonyManager, WifiManager and AudioManager,
     each call with the answer or the exception Android 15 gives an app that holds ACCESS_WIFI_STATE and no other
     permission of these. The launcher activity is the framework's own android.app.Activity, so that `am start` starts
     the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.answers" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.answers.AnswersApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
