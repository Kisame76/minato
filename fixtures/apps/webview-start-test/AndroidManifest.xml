<?xml version="1.0" encoding="utf-8"?>
<!-- A WebView that starts (webview-start-test, ADR-0056 step b1): the launcher activity makes a WebView as its content
     and logs what it answers before any page loads, its settings, its user agent's shape and the WebView package as
     the app sees it, and how the empty view draws. No network and no page: the answers come from the provider. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.webviewstart" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name="io.github.kisame76.minato.test.webviewstart.WebViewStartActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
