<?xml version="1.0" encoding="utf-8"?>
<!-- widgets-test's GridLayout: three columns of views in px, one of them across two columns, and a TableLayout whose
     second column stretches. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <GridLayout android:id="@+id/grid" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:columnCount="3">
    <View android:id="@+id/g1" android:layout_width="200px" android:layout_height="100px"/>
    <View android:id="@+id/g2" android:layout_width="250px" android:layout_height="120px"/>
    <View android:id="@+id/g3" android:layout_width="150px" android:layout_height="100px"/>
    <View android:id="@+id/g4" android:layout_width="300px" android:layout_height="80px" android:layout_columnSpan="2"/>
    <View android:id="@+id/g5" android:layout_width="100px" android:layout_height="140px"/>
    <View android:id="@+id/g6" android:layout_width="120px" android:layout_height="60px"
        android:layout_gravity="end|bottom"/>
  </GridLayout>
  <TableLayout android:id="@+id/table" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:stretchColumns="1">
    <TableRow android:id="@+id/row1">
      <View android:id="@+id/t11" android:layout_width="100px" android:layout_height="50px"/>
      <View android:id="@+id/t12" android:layout_width="200px" android:layout_height="60px"/>
      <View android:id="@+id/t13" android:layout_width="150px" android:layout_height="40px"/>
    </TableRow>
    <TableRow android:id="@+id/row2">
      <View android:id="@+id/t21" android:layout_width="180px" android:layout_height="70px"/>
      <View android:id="@+id/t22" android:layout_width="50px" android:layout_height="30px"/>
    </TableRow>
  </TableLayout>
  <Space android:id="@+id/space" android:layout_width="123px" android:layout_height="45px"/>
</LinearLayout>
