<?xml version="1.0" encoding="utf-8"?>
<!-- widgets-test's RelativeLayout: views of fixed sizes in px, placed by the parent's edges and center and by one
     another. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
  <View android:id="@+id/a" android:layout_width="300px" android:layout_height="200px"
      android:layout_alignParentTop="true" android:layout_alignParentStart="true"/>
  <View android:id="@+id/b" android:layout_width="200px" android:layout_height="100px"
      android:layout_toEndOf="@id/a" android:layout_alignBottom="@id/a"/>
  <View android:id="@+id/c" android:layout_width="400px" android:layout_height="150px"
      android:layout_below="@id/a" android:layout_centerHorizontal="true"/>
  <View android:id="@+id/d" android:layout_width="100px" android:layout_height="100px"
      android:layout_centerInParent="true"/>
  <View android:id="@+id/e" android:layout_width="250px" android:layout_height="120px"
      android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:layout_margin="20px"/>
  <View android:id="@+id/f" android:layout_width="150px" android:layout_height="150px"
      android:layout_above="@id/e" android:layout_alignStart="@id/e"/>
  <View android:id="@+id/g" android:layout_width="match_parent" android:layout_height="80px"
      android:layout_below="@id/c" android:layout_marginTop="10px"/>
</RelativeLayout>
