<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0058 c)'s test of SurfaceTexture (surface-texture-test): a GL thread with its external texture, a Canvas
     producer through Surface(SurfaceTexture), onFrameAvailable on the creator's Looper, updateTexImage, the transform
     and the timestamp, the pixels drawn through samplerExternalOES, and release. The launcher activity is the
     framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.surfacetexture" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00020000" android:required="true"/>
  <application android:label="SurfaceTexture Test"
      android:name="io.github.kisame76.minato.test.surfacetexture.SurfaceTextureApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
