<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c1's test (context-test): what the app's Context gives in Application.attachBaseContext, which
     Android calls as it makes the application: its paths, files, SharedPreferences across two starts, a string, an
     asset and permission checks. It requests INTERNET and not CAMERA. The launcher activity is the framework's own
     android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.context" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.context.ContextApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
