<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0041 decision 10 step b2's test of the edge back gesture: an opted-in app (enableOnBackInvokedCallback) whose
     window is one pad that logs the touches it gets and whose OnBackAnimationCallback logs the gesture's phases;
     the pad excludes a band of its left edge from system gestures. Its twins -landscape, -immersive (system bars
     hidden, shown by a swipe) and -immersive-landscape take its sources; the label, the tag of their lines, names
     the mode. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.edgeback" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
      android:enableOnBackInvokedCallback="true">
    <activity android:name="io.github.kisame76.minato.test.edgeback.EdgeActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
