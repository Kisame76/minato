<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039's test 1 (app-start-test): the Application class prints the process's environment, name and uid. The
     launcher activity is the framework's own android.app.Activity, so that `am start` starts the process on
     Android; step a's driver loads only the Application class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.appstart" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="App Start Test"
      android:name="io.github.kisame76.minato.test.appstart.StartApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
