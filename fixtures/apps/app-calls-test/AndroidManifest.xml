<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 step c2d's test (app-calls-test): calls an app makes into the platform without a window, which failed
     on Minato while the classes behind them were compile-only stubs. Step c2d1: Log.wtf. The launcher activity is the
     framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.appcalls" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.appcalls.AppCallsApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
