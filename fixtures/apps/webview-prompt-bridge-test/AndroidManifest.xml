<?xml version="1.0" encoding="utf-8"?>
<!-- A page of the app's assets that calls the app through prompt() (webview-prompt-bridge-test, ADR-0056), as older
     hybrid app frameworks do: the WebChromeClient's onJsPrompt answers calls whose default starts with "gap:", the
     page fires its ready event after the first answer and asks the app to hide the splash over the WebView. No
     network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.webviewprompt" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name="io.github.kisame76.minato.test.webviewprompt.PromptActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
