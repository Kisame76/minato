<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the clipboard (clipboard-test): getSystemService("clipboard"), the primary clip set, read and cleared,
     its description, the text check, the copies and the listeners (the Unity test APK probe's blocker 11). Android gives the
     clipboard only to the app that has the focus, so the test runs in its launcher activity when the window first has it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.clipboard" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name">
    <activity android:name="io.github.kisame76.minato.test.clipboard.ClipboardActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
