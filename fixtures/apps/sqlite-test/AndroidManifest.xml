<?xml version="1.0" encoding="utf-8"?>
<!-- The SQLite test (sqlite-test): an app's own SQLite databases through android.database.sqlite,
     opened on the main thread as Firebase's datatransport opens its event store. Its activity creates, upgrades and
     deletes a database with SQLiteOpenHelper, and writes and reads it with ContentValues, cursors, statements,
     transactions, Android's SQL functions and collations, FTS and WAL. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.sqlite" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="sqlite-test">
    <activity android:name="io.github.kisame76.minato.test.sqlite.SqliteActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
