<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0039 decision 3's test of the owner rules for the calls that change a file or a folder's entries
     (owner-rules-test): on the app's own APK and code folder, which belong to system, and in its data, cache and
     external files folders, which are its own; it logs each call's answer. The launcher activity is the framework's
     own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.ownerrules" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="Owner Rules Test"
      android:name="io.github.kisame76.minato.test.ownerrules.OwnerRulesApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
