<?xml version="1.0" encoding="utf-8"?>
<!-- The test of the intents that leave the app for iOS (open-test; ADR-0062): what links, calls, texts, mail, maps and
     shares resolve to, and that what resolves to nothing throws what Android 15 throws. The launcher activity is the
     framework's own android.app.Activity, so that `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.open" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <!-- Android 11's package visibility: without these the emulator shows the app neither its browser nor its dialer, and
       resolveActivity answers null. Minato applies no visibility yet (a named limit of ADR-0062), so the app declares
       what a modern app declares, and both answer the same. -->
  <queries>
    <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="http"/></intent>
    <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https"/></intent>
    <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="tel"/></intent>
    <intent><action android:name="android.intent.action.DIAL"/><data android:scheme="tel"/></intent>
    <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="mailto"/></intent>
    <intent><action android:name="android.intent.action.SENDTO"/><data android:scheme="mailto"/></intent>
    <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="geo"/></intent>
  </queries>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.open.OpenApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
