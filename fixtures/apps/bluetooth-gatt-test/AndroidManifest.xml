<?xml version="1.0" encoding="utf-8"?>
<!-- The test of Bluetooth's GATT classes and the adapter's answers (bluetooth-gatt-test): the services, characteristics
     and descriptors an app builds, the callbacks it subclasses, the remote device it asks for by address and the
     connection it tries to open on an adapter that is off, each with the answer or the exception Android 15 gives an
     app that holds no Bluetooth permission. The launcher activity is the framework's own android.app.Activity, so that
     `am start` starts the process on Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.test.bluetoothgatt" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <application android:label="@string/app_name"
      android:name="io.github.kisame76.minato.test.bluetoothgatt.GattApplication">
    <activity android:name="android.app.Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
