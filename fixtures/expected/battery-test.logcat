I/battery-test: sticky extras: android.os.extra.CHARGING_STATUS:Integer, android.os.extra.CYCLE_COUNT:Integer, battery_low:Boolean, charge_counter:Integer, health:Integer, icon-small:Integer, invalid_charger:Integer, level:Integer, max_charging_current:Integer, max_charging_voltage:Integer, plugged:Integer, present:Boolean, scale:Integer, seq:Integer, status:Integer, technology:String, temperature:Integer, voltage:Integer
I/battery-test: sticky: level 100, scale 100, status 2, plugged 1, low false
