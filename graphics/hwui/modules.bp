// graphics/hwui (ADR-0043 a1): Minato's modules in place of those of projects we do not fetch, of Rust and of
// generators, and of bionic's huge page defaults (a2), for tools/hwui-plan.py. Read in Soong's syntax, after the
// projects' own files.

// minikin's Rust bridge (cxx), which minikin without Rust (patch 0001) does not include: generators without outputs.
filegroup {
    name: "cxx-bridge-header",
}

filegroup {
    name: "libminikin_cxx_bridge_header",
}

filegroup {
    name: "libminikin_cxx_bridge_code",
}

// The aconfig flags of hwui and of the text stack, generated by tools/hwui-plan.py as constants of Android 15's
// release values (tools/aconfig-flags.py cc).
cc_library_static {
    name: "hwui_flags_cc_lib",
    export_include_dirs: ["generated/flags"],
}

cc_library_headers {
    name: "aconfig_text_flags_c_lib",
    export_include_dirs: ["generated/flags"],
}

// liblog: the guest system's own liblog.so (runtime/bionic/src/liblog.cpp) with the headers of system/logging, as for
// ART (runtime/art/modules.bp).
cc_library {
    name: "liblog",
    export_include_dirs: ["../../system/logging/liblog/include"],
}

cc_library_headers {
    name: "liblog_headers",
    export_include_dirs: ["../../system/logging/liblog/include"],
}

// googletest's FRIEND_TEST for libziparchive's headers.
cc_library_headers {
    name: "libgtest_prod_headers",
    export_include_dirs: ["../../external/googletest/googletest/include"],
}

// bionic's linker_hugepage_aligned, which libhwui's defaults name, without its 2 MiB max page size (ADR-0043 a2): that
// alignment is for Linux's transparent huge pages, while the guest's pages are 16 KB, which
// graphics/hwui/CMakeLists.txt links the whole set with. Ours takes the place of bionic's, as every module here does
// that has an AOSP name.
cc_defaults {
    name: "linker_hugepage_aligned",
}
