<?xml version="1.0" encoding="utf-8"?>
<!-- bench-gles31 (ADR-0044 d2)): bench-gles's scene and library under a manifest that requires ES 3.1, so that Minato
     starts it on ANGLE's Vulkan backend (ADR-0044 decision 4); its runs are reported beside bench-gles's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.bench.gles31"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00030001" android:required="true"/>
  <application android:label="Bench GLES 3.1" android:hasCode="false"
      android:extractNativeLibs="false">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="bench-gles"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
