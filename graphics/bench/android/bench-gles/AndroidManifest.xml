<?xml version="1.0" encoding="utf-8"?>
<!-- bench-gles (ADR-0037, decision 1): the parity benchmark's scene with GLES 3.0, a NativeActivity app that draws
     a frame per AChoreographer callback for bench.conf's seconds and then finishes itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kisame76.minato.bench.gles"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <application android:label="Bench GLES" android:hasCode="false"
      android:extractNativeLibs="false">
    <activity android:name="android.app.NativeActivity" android:exported="true">
      <meta-data android:name="android.app.lib_name" android:value="bench-gles"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
