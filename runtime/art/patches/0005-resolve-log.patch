+++ b/art/runtime/class_linker-inl.h
@@ -30,6 +30,7 @@
 #include "gc_root-inl.h"
 #include "handle_scope-inl.h"
 #include "jni/jni_internal.h"
+#include "minato_resolve_log.h"
 #include "mirror/class_loader.h"
 #include "mirror/dex_cache-inl.h"
 #include "mirror/iftable.h"
@@ -421,6 +422,8 @@
     const char* name = dex_file.GetStringData(method_id.name_idx_);
     const Signature signature = dex_file.GetMethodSignature(method_id);
     ThrowNoSuchMethodError(type, klass, name, signature);
+    // Minato: name the missing method (minato_resolve_log.h).
+    minato_resolve::Report(Thread::Current(), "method " + dex_file.PrettyMethod(method_idx));
   }
   Thread::Current()->AssertPendingException();
   return nullptr;
@@ -489,6 +492,8 @@
     const char* name = dex_file.GetFieldName(field_id);
     const char* type = dex_file.GetFieldTypeDescriptor(field_id);
     ThrowNoSuchFieldError(is_static ? "static " : "instance ", klass, type, name);
+    // Minato: name the missing field (minato_resolve_log.h).
+    minato_resolve::Report(Thread::Current(), "field " + minato_resolve::FieldName(dex_file, field_idx));
   }
   return resolved;
 }
