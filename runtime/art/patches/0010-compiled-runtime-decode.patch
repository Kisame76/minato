+
+// For a base that is null when it names no object (Unsafe's absolute addresses): null stays null.
+inline void DecodeReferenceOrNull(vixl::aarch64::MacroAssembler* masm, const vixl::aarch64::Register& ref) {
+  vixl::aarch64::UseScratchRegisterScope temps(masm);
+  vixl::aarch64::Register decoded = temps.AcquireX();
+  masm->Orr(decoded, mr, ref.X());
+  masm->Cmp(ref.W(), 0);
+  masm->Csel(ref.X(), vixl::aarch64::xzr, decoded, vixl::aarch64::eq);
 }
 
