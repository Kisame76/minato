Minato (M6 c2, ADR-0053): the optimizing compiler's arm64 code generator decodes references. A reference is the low
32 bits of the object's address in the heap window (heap_window.h), so a reference that only sits in a W register must
become an address before a memory operand uses it: DecodeReference (orr xN, x20, xN, the window's base in x20, in
place and harmless on an address; null becomes B, the guard page, which gives an implicit null check its fault), as
nterp does (patch 0008). The card mark indexes the card table by the address (B | reference).
 - every HeapOperand use of the code generator decodes its base (DecodedHeapOperand); the hand-built operands do too
   (the vtable and imt loads from a class, ClassTableGet, the array length of a compressed string, the vector
   addresses);
 - the allocation stubs' fast paths (rosalloc and TLAB) read the class in x0, which only compiled code passes: they
   decode it first (w0 stays the reference for the class store);
 - runtime/art/codec-sites.txt lists every place; tools/art-codec-sites.py checks it. GenerateVirtualCall's
   vtable load was marked raw there and is a decode.

--- a/art/compiler/optimizing/code_generator_arm64.h
+++ b/art/compiler/optimizing/code_generator_arm64.h
@@ -79,7 +79,7 @@
 
 // Thread Register.
 const vixl::aarch64::Register tr = vixl::aarch64::x19;
-// Marking Register.
+// Marking Register. Minato (ADR-0053 M6): without read barriers it holds the heap window's base B (patch 0007).
 const vixl::aarch64::Register mr = vixl::aarch64::x20;
 // Implicit suspend check register.
 const vixl::aarch64::Register kImplicitSuspendCheckRegister = vixl::aarch64::x21;
@@ -122,6 +122,43 @@
                                                           vixl::aarch64::d8.GetCode(),
                                                           vixl::aarch64::d15.GetCode());
 Location ARM64ReturnLocation(DataType::Type return_type);
+
+// Minato (ADR-0053 M6 c2): a heap reference in a W register is the low 32 bits of the object's address, so a memory
+// operand needs the window's base B, which x20 holds. The decode is `orr xN, x20, xN`, in place: harmless on an
+// address, null becomes B (the guard page of patch 0006, which gives an implicit null check its fault), and the W
+// register, which is all that a reference use reads, stays what it was. nterp does the same (patch 0008).
+inline void DecodeReference(vixl::aarch64::MacroAssembler* masm, const vixl::aarch64::Register& ref) {
+  DCHECK(ref.IsW() || ref.IsX());
+  masm->Orr(ref.X(), mr, ref.X());
+}
+
+inline vixl::aarch64::MemOperand DecodedHeapOperand(vixl::aarch64::MacroAssembler* masm,
+                                                    const vixl::aarch64::Register& base,
+                                                    size_t offset = 0) {
+  DecodeReference(masm, base);
+  return helpers::HeapOperand(base, offset);
+}
+
+inline vixl::aarch64::MemOperand DecodedHeapOperand(vixl::aarch64::MacroAssembler* masm,
+                                                    const vixl::aarch64::Register& base,
+                                                    const vixl::aarch64::Register& regoffset,
+                                                    vixl::aarch64::Shift shift = vixl::aarch64::LSL,
+                                                    unsigned shift_amount = 0) {
+  DecodeReference(masm, base);
+  return helpers::HeapOperand(base, regoffset, shift, shift_amount);
+}
+
+inline vixl::aarch64::MemOperand DecodedHeapOperand(vixl::aarch64::MacroAssembler* masm,
+                                                    const vixl::aarch64::Register& base,
+                                                    Offset offset) {
+  return DecodedHeapOperand(masm, base, offset.SizeValue());
+}
+
+inline vixl::aarch64::MemOperand DecodedHeapOperandFrom(vixl::aarch64::MacroAssembler* masm,
+                                                        Location location,
+                                                        Offset offset) {
+  return DecodedHeapOperand(masm, helpers::RegisterFrom(location, DataType::Type::kReference), offset);
+}
 
