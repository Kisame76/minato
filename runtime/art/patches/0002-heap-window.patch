+// Minato (ADR-0033 decision 3): the heap window (base/heap_window.h).
+uintptr_t gHeapWindowBase = 0u;
+size_t gHeapWindowSize = 0u;
+uintptr_t gHeapWindowFirst = 0u;
+
+// 4 GiB, as far as 32-bit offsets reach.
+static constexpr size_t kHeapWindowSize = 4 * GB;
+
+// Guards the window's reservation and its ranges.
+static std::mutex& HeapWindowLock() {
+  static std::mutex* lock = new std::mutex();
+  return *lock;
+}
+
+// Where mappings go in the window and which ranges they hold (base/heap_window_ranges.h), from the reservation on.
+static HeapWindowRanges* gHeapWindowRanges = nullptr;
+
+// Reserves the window: twice its size without access, cut to the part aligned to 4 GiB.
+static void ReserveHeapWindow() {
+  const size_t length = kHeapWindowSize + 4 * GB;
+  void* reservation = mmap(nullptr, length, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+  if (reservation == MAP_FAILED) {
+    PLOG(FATAL) << "Could not reserve the heap window of " << kHeapWindowSize << " bytes";
+  }
+  const uintptr_t begin = reinterpret_cast<uintptr_t>(reservation);
+  const uintptr_t base = RoundUp(begin, 4 * GB);
+  if (base != begin) {
+    CHECK_EQ(munmap(reservation, base - begin), 0);
+  }
+  CHECK_EQ(munmap(reinterpret_cast<void*>(base + kHeapWindowSize), begin + length - (base + kHeapWindowSize)), 0);
+  gHeapWindowRanges = new HeapWindowRanges(base, kHeapWindowSize, MemMap::GetPageSize());
+  gHeapWindowSize = kHeapWindowSize;
+  gHeapWindowFirst = gHeapWindowRanges->First();
+  gHeapWindowBase = base;
+}
+
+uint8_t* MemMap::HeapWindowBegin() {
+  std::lock_guard<std::mutex> lock(HeapWindowLock());
+  if (gHeapWindowBase == 0u) {
+    ReserveHeapWindow();
+  }
+  return reinterpret_cast<uint8_t*>(gHeapWindowBase);
+}
+
+size_t MemMap::HeapWindowSize() {
+  HeapWindowBegin();
+  return gHeapWindowSize;
+}
+
+void* MemMap::MapInHeapWindow(void* addr, size_t length, int prot, int flags, int fd, off_t offset) {
+  HeapWindowBegin();
+  const uintptr_t begin = reinterpret_cast<uintptr_t>(addr);
+  if ((flags & MAP_FIXED) != 0) {
+    // Into a mapping of the caller's own (reuse, a reservation, the tail of RemapAtEnd), in the window already.
+    if (!gHeapWindowRanges->Holds(begin, length)) {
+      errno = EINVAL;
+      return MAP_FAILED;
+    }
+    return TargetMMap(addr, length, prot, flags, fd, offset);
+  }
+  std::lock_guard<std::mutex> lock(HeapWindowLock());
+  // An address without MAP_FIXED is a hint, as for mmap: taken where the window has room for the mapping
+  // there; else, as Linux would, the mapping goes elsewhere, and ART, which checks the address it gets, gives
+  // it back and asks again without one. A low address, which ART asks for on Android, lies outside the window.
+  const uintptr_t placed = gHeapWindowRanges->Place(begin, length);
+  if (placed == 0u) {
+    LOG(ERROR) << "The heap window has no room for " << length << " bytes.";
+    errno = ENOMEM;
+    return MAP_FAILED;
+  }
+  void* actual = TargetMMap(reinterpret_cast<void*>(placed), length, prot, flags | MAP_FIXED, fd, offset);
+  if (actual != MAP_FAILED) {
+    gHeapWindowRanges->Add(placed, length);
+  }
+  return actual;
+}
 
+bool MemMap::ReturnToHeapWindow(void* start, size_t length) {
+  const uintptr_t begin = reinterpret_cast<uintptr_t>(start);
+  if (gHeapWindowBase == 0u || begin < gHeapWindowBase || begin - gHeapWindowBase >= gHeapWindowSize) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(HeapWindowLock());
+  // Without access again, as reserved, before the window gives the range out again.
+  void* actual =
+      mmap(start, length, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED, -1, 0);
+  CHECK_EQ(actual, start) << "Could not give " << length << " bytes back to the heap window";
+  gHeapWindowRanges->Remove(begin, length);
+  return true;
+}
