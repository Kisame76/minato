# macOS
.DS_Store

# Generated by XcodeGen from project.yml
*.xcodeproj/
app/Info.plist
app/Minato.entitlements

# Xcode
xcuserdata/
*.xcworkspace/
build/
DerivedData/

# Swift Package Manager
.build/
.swiftpm/

# Signing identities and profiles (certificates, private keys) never go into the repo (ADR-0022)
*.p12
*.cer
*.pem
*.key
*.p8
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# Release outputs (tools/release.sh builds them under build/release)
*.ipa
*.xcarchive/
*.dSYM/
*.xcresult/

# No APKs or app bundles in the repo; the OBB test's own files are the exception
*.apk
*.apks
*.xapk
*.apkm
*.aab
*.obb
!fixtures/apps/obb-test/*.obb

# CMake / Android NDK
.cxx/
cmake-build-*/

# Local test APKs (never committed; checked before use)
/apk/

# Python
__pycache__/
*.pyc

# Editors and local settings
.idea/
.vscode/
*.swp
.env

# graphify's knowledge graph of the code, built locally (.graphifyignore)
graphify-out/*
# !graphify-out/graph.html
# !graphify-out/GRAPH_REPORT.md
# !graphify-out/graph.json
.claude/
CLAUDE.md
.graphifyignore
