+bool CommandQueue::submitOrDefer(id<MTLCommandBuffer> buf, uint64_t serial, size_t bytes)
+{
+    int (*enter)(void)          = gCommitEnter.load(std::memory_order_acquire);
+    void (*counted)(void)       = gCommitCounted.load(std::memory_order_acquire);
+    void (*waitForeground)(void) = gWaitForeground.load(std::memory_order_acquire);
+    if (enter == nullptr)
+    {
+        return false;
+    }
+    std::unique_lock<std::mutex> lk(mSubmitLock);
+    for (;;)
+    {
+        if (enter())
+        {
+            commitDeferredLocked();
+            commitNow(buf, serial);
+            if (counted != nullptr)
+            {
+                counted();
+            }
+            return true;
+        }
+        if (mDeferred.size() < kMaxDeferred && mDeferredBytes + bytes <= kMaxDeferredBytes)
+        {
+            mDeferred.push_back({buf, serial, bytes});
+            mDeferredBytes += bytes;
+            // Committed for ANGLE's bookkeeping: its resources wait for this serial, and a wait for
+            // its result goes through waitForDeferred.
+            mCommittedBufferSerial.storeMaxValue(serial);
+            gDeferredNow.fetch_add(1, std::memory_order_relaxed);
+            const uint64_t now = gDeferredBytes.fetch_add(bytes, std::memory_order_relaxed) + bytes;
+            uint64_t peak = gDeferredBytesPeak.load(std::memory_order_relaxed);
+            while (now > peak && !gDeferredBytesPeak.compare_exchange_weak(peak, now)) {}
+            gDeferredTotal.fetch_add(1, std::memory_order_relaxed);
+            return true;
+        }
+        // The FIFO is full: this commit waits for the foreground, as every commit did before.
+        gDeferredFull.fetch_add(1, std::memory_order_relaxed);
+        lk.unlock();
+        if (waitForeground != nullptr)
+        {
+            waitForeground();
+        }
+        lk.lock();
     }
 }
 
+void CommandQueue::commitNow(id<MTLCommandBuffer> buf, uint64_t serial)
+{
+    onCommandBufferCommitted(buf, serial);
+    [buf enqueue];
+    [buf commit];
+}
+
+void CommandQueue::commitDeferredLocked()
+{
+    for (DeferredEntry &entry : mDeferred)
+    {
+        commitNow(entry.buffer.get(), entry.serial);
+        gDeferredNow.fetch_sub(1, std::memory_order_relaxed);
+        gDeferredBytes.fetch_sub(entry.bytes, std::memory_order_relaxed);
+    }
+    mDeferred.clear();
+    mDeferredBytes = 0;
+}
+
+void CommandQueue::submitDeferred()
+{
+    int (*enter)(void)    = gCommitEnter.load(std::memory_order_acquire);
+    void (*counted)(void) = gCommitCounted.load(std::memory_order_acquire);
+    if (enter == nullptr)
+    {
+        return;
+    }
+    std::lock_guard<std::mutex> lg(mSubmitLock);
+    if (mDeferred.empty() || !enter())
+    {
+        return;
+    }
+    commitDeferredLocked();
+    if (counted != nullptr)
+    {
+        counted();
+    }
+}
+
+bool CommandQueue::isDeferred(uint64_t serial) const
+{
+    std::lock_guard<std::mutex> lg(mSubmitLock);
+    for (const DeferredEntry &entry : mDeferred)
+    {
+        if (entry.serial == serial)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+void CommandQueue::waitForDeferred(uint64_t serial)
+{
+    void (*waitForeground)(void) = gWaitForeground.load(std::memory_order_acquire);
+    while (isDeferred(serial))
+    {
+        if (waitForeground != nullptr)
+        {
+            waitForeground();
+        }
+        submitDeferred();
+    }
+}
