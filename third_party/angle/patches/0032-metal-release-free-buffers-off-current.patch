 namespace
 {
+// Minato (patch 0032): per thread, the context last let go there whose free buffers wait for another context to be
+// made current on that thread. A context made current again on any thread, or destroyed, leaves the map.
+std::mutex &PendingFreeBuffersMutex()
+{
+    static std::mutex *mutex = new std::mutex;
+    return *mutex;
+}
+
+std::unordered_map<std::thread::id, ContextMtl *> &PendingFreeBuffers()
+{
+    static auto *pending = new std::unordered_map<std::thread::id, ContextMtl *>;
+    return *pending;
+}
+
+void ForgetPendingFreeBuffers(ContextMtl *contextMtl)
+{
+    auto &pending = PendingFreeBuffers();
+    for (auto iter = pending.begin(); iter != pending.end();)
+    {
+        iter = iter->second == contextMtl ? pending.erase(iter) : std::next(iter);
+    }
+}
+
