+// The held copies' bytes, the most held, and whether a pack may hold (the context thread's last tick says so).
+std::atomic<size_t> gHeldBytes{0};
+std::atomic<size_t> gHeldPeak{0};
+std::atomic<bool> gHoldOpen{true};
+
+bool HoldEnabled()
+{
+    static const bool enabled = [] {
+        const char *hold = getenv("MINATO_ANGLE_PARK_HOLD");
+        return hold == nullptr || strcmp(hold, "0") != 0;
+    }();
+    return enabled;
+}
+
+// Counts |bytes| as held when they fit under the cap and holding is open.
+bool Hold(size_t bytes)
+{
+    if (!HoldEnabled() || !gHoldOpen.load(std::memory_order_relaxed))
+    {
+        return false;
+    }
+    size_t held = gHeldBytes.load(std::memory_order_relaxed);
+    do
+    {
+        if (held + bytes > kHoldCap)
+        {
+            return false;
+        }
+    } while (!gHeldBytes.compare_exchange_weak(held, held + bytes, std::memory_order_relaxed));
+    size_t peak = gHeldPeak.load(std::memory_order_relaxed);
+    while (peak < held + bytes &&
+           !gHeldPeak.compare_exchange_weak(peak, held + bytes, std::memory_order_relaxed))
+    {
+    }
+    return true;
+}
+
+void Unhold(size_t bytes)
+{
+    gHeldBytes.fetch_sub(bytes, std::memory_order_relaxed);
+}
