new file mode 100644
index 0000000..be12aa7
--- /dev/null
+++ b/src/libANGLE/renderer/vulkan/ios/WindowSurfaceVkIOS.mm
@@ -0,0 +1,59 @@
+//
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// WindowSurfaceVkIOS.mm:
+//    Implements methods from WindowSurfaceVkIOS
+//
+
+#include "libANGLE/renderer/vulkan/ios/WindowSurfaceVkIOS.h"
+
+#include "libANGLE/renderer/vulkan/vk_renderer.h"
+#include "libANGLE/renderer/vulkan/vk_utils.h"
+
+namespace rx
+{
+
+WindowSurfaceVkIOS::WindowSurfaceVkIOS(const egl::SurfaceState &surfaceState,
+                                       EGLNativeWindowType window)
+    : WindowSurfaceVk(surfaceState, window), mMetalLayer(nullptr)
+{}
+
+WindowSurfaceVkIOS::~WindowSurfaceVkIOS()
+{
+    [mMetalLayer release];
+}
+
+// The surface draws to the given layer, as SurfaceMtl does on iOS: its owner sizes and places it
+// and sees each drawable it presents, which a sublayer would hide. The swapchain sets its device,
+// drawable size and framebufferOnly.
+angle::Result WindowSurfaceVkIOS::createSurfaceVk(vk::ErrorContext *context)
+{
+    mMetalLayer = [reinterpret_cast<CAMetalLayer *>(mNativeWindowType) retain];
+
+    VkMetalSurfaceCreateInfoEXT createInfo = {};
+    createInfo.sType                       = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT;
+    createInfo.flags                       = 0;
+    createInfo.pNext                       = nullptr;
+    createInfo.pLayer                      = mMetalLayer;
+    ANGLE_VK_TRY(context, VK_CALL(vkCreateMetalSurfaceEXT, context->getRenderer()->getInstance(),
+                                  &createInfo, nullptr, &mSurface));
+
+    return angle::Result::Continue;
+}
+
+// The layer's size in pixels, bounds times contentsScale, as MoltenVK gives a surface's current
+// extent; the drawable size stays the swapchain's.
+angle::Result WindowSurfaceVkIOS::getCurrentWindowSize(vk::ErrorContext *context,
+                                                       gl::Extents *extentsOut) const
+{
+    ANGLE_VK_CHECK(context, (mMetalLayer != nullptr), VK_ERROR_INITIALIZATION_FAILED);
+    const CGSize size   = mMetalLayer.bounds.size;
+    const CGFloat scale = mMetalLayer.contentsScale;
+    *extentsOut         = gl::Extents(static_cast<int>(size.width * scale),
+                                      static_cast<int>(size.height * scale), 1);
+    return angle::Result::Continue;
+}
+
+}  // namespace rx
