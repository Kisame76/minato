diff --git a/src/libANGLE/renderer/vulkan/ios/DisplayVkIOS.mm b/src/libANGLE/renderer/vulkan/ios/DisplayVkIOS.mm
new file mode 100644
index 0000000..38da70f
--- /dev/null
+++ b/src/libANGLE/renderer/vulkan/ios/DisplayVkIOS.mm
@@ -0,0 +1,63 @@
+//
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// DisplayVkIOS.mm:
+//    Implements methods from DisplayVkIOS
+//
+
+#include "libANGLE/renderer/vulkan/ios/DisplayVkIOS.h"
+
+#include <vulkan/vulkan.h>
+
+#include "libANGLE/renderer/vulkan/DisplayVk_api.h"
+#include "libANGLE/renderer/vulkan/ios/WindowSurfaceVkIOS.h"
+#include "libANGLE/renderer/vulkan/vk_caps_utils.h"
+
+#import <QuartzCore/CAMetalLayer.h>
+
+namespace rx
+{
+
+DisplayVkIOS::DisplayVkIOS(const egl::DisplayState &state) : DisplayVk(state) {}
+
+// The window is the CAMetalLayer the surface draws to, as the Metal backend takes one on iOS.
+bool DisplayVkIOS::isValidNativeWindow(EGLNativeWindowType window) const
+{
+    NSObject *layer = reinterpret_cast<NSObject *>(window);
+    return [layer isKindOfClass:[CAMetalLayer class]];
+}
+
+SurfaceImpl *DisplayVkIOS::createWindowSurfaceVk(const egl::SurfaceState &state,
+                                                 EGLNativeWindowType window)
+{
+    ASSERT(isValidNativeWindow(window));
+    return new WindowSurfaceVkIOS(state, window);
+}
+
+egl::ConfigSet DisplayVkIOS::generateConfigs()
+{
+    constexpr GLenum kColorFormats[] = {GL_BGRA8_EXT, GL_BGRX8_ANGLEX};
+    return egl_vk::GenerateConfigs(kColorFormats, egl_vk::kConfigDepthStencilFormats, this);
+}
+
+void DisplayVkIOS::checkConfigSupport(egl::Config *config) {}
+
+const char *DisplayVkIOS::getWSIExtension() const
+{
+    return VK_EXT_METAL_SURFACE_EXTENSION_NAME;
+}
+
+// Display.cpp asks for the Mac display on every Apple platform; on iOS it is this one.
+bool IsVulkanMacDisplayAvailable()
+{
+    return true;
+}
+
+DisplayImpl *CreateVulkanMacDisplay(const egl::DisplayState &state)
+{
+    return new DisplayVkIOS(state);
+}
+
+}  // namespace rx
