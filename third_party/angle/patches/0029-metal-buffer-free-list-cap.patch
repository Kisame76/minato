     }
     mInUseBuffers.erase(mInUseBuffers.begin(), firstInUseIter);
+    // Minato (patch 0029): in the background no command buffer completes (patch 0025), so every buffer an app makes
+    // there is a new one; back in the foreground they all come here at once, and collectGarbage keeps them until 120
+    // context switches, 5000 commits or 64 MiB more allocated. Keep at most kMaxFreeBytes of them.
+    if (mFreeBytes > kMaxFreeBytes)
+    {
+        trimFreeLists();
+    }
+}
+
+void BufferManager::trimFreeLists()
+{
+    // The largest free buffers go first: the small ones are the ones a frame makes again and again.
+    while (mFreeBytes > kMaxFreeBytes)
+    {
+        BufferMap *largestMap = nullptr;
+        for (int i = 0; i < kNumCachedStorageModes; ++i)
+        {
+            BufferMap &map = ANGLE_UNSAFE_TODO(mFreeBuffers[i]);
+            if (!map.empty() && (largestMap == nullptr || map.rbegin()->first > largestMap->rbegin()->first))
+            {
+                largestMap = &map;
+            }
+        }
+        if (largestMap == nullptr)
+        {
+            mFreeBytes = 0;
+            break;
+        }
+        auto largest       = std::prev(largestMap->end());
+        const size_t bytes = largest->first;
+        NoteBufferPoolFree(-1, -static_cast<int64_t>(bytes));
+        largestMap->erase(largest);
+        mFreeBytes -= bytes;
+        mTotalMem -= std::min(mTotalMem, bytes);
+    }
 }
 
