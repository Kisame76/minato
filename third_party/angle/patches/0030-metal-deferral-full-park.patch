+// Minato (patch 0030): the embedder's answer to a full FIFO: 1 once it parked the committing thread until the
+// foreground (then nothing is lost), 0 at once when it does not park (then the oldest goes, as patch 0027 has it).
+std::atomic<int (*)(void)> gDeferralFullPark{nullptr};
+std::atomic<uint64_t> gDeferredParked{0};
+// Minato (patch 0030), for tests only: MINATO_ANGLE_DROP_DISCARDS=1 does to the oldest command buffer of a full FIFO
+// what iOS does to a background commit: nothing of it reaches the GPU; ANGLE's bookkeeping completes it. The Mac's
+// Metal would run it, so a test could not see the work that the iPhone loses.
+bool DropDiscards()
+{
+    static const bool discards = [] {
+        const char *value = getenv("MINATO_ANGLE_DROP_DISCARDS");
+        return value != nullptr && strcmp(value, "1") == 0;
+    }();
+    return discards;
+}
 std::mutex gQueuesLock;
 std::vector<const CommandQueue *> gQueues;
 
