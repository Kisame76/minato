         }
+        // Minato (patch 0030): the FIFO is full. The embedder may park this thread until the foreground (once
+        // the app's onStop and its surfaces' surfaceDestroyed are answered), without the FIFO's lock: then
+        // nothing is lost, as on Android, whose GPU runs in the background; the loop then commits at the top.
+        if (int (*park)(void) = gDeferralFullPark.load(std::memory_order_acquire))
+        {
+            lk.unlock();
+            const int parked = park();
+            lk.lock();
