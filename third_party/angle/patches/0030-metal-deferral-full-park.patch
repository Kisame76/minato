+// Minato (patch 0030): the embedder's answer to a full FIFO in the background (gDeferralFullPark), or none.
+extern "C" ANGLE_EXPORT void ANGLEMetalSetDeferralFull(int (*park)(void))
+{
+    rx::mtl::gDeferralFullPark.store(park, std::memory_order_release);
+}
+
+// Minato (patch 0030): the full FIFOs whose committing thread the embedder parked instead of a drop.
+extern "C" ANGLE_EXPORT uint64_t ANGLEMetalDeferredParked()
+{
+    return rx::mtl::gDeferredParked.load(std::memory_order_relaxed);
+}
+
