Define ANGLE's SPIR-V helper targets only when SPIR-V is used (ADR-0029, decision 8: a build fix).

Why: src/common/spirv/BUILD.gn defines angle_spirv_base, angle_spirv_builder and angle_spirv_parser
unconditionally, with dependencies on SPIRV-Headers and SPIRV-Tools. The translator always depends on
angle_spirv_headers from the same file, so gn gen loads the file, and with it the BUILD.gn of both SPIR-V
repositories, even for a Metal-only build that compiles none of them. Minato's checkout leaves those
repositories out (ADR-0029, decision 2).
Upstream: could go upstream; the condition is //BUILD.gn's own for _uses_spirv. Not proposed yet.
Remove: when upstream guards these targets, or if the checkout ever keeps SPIRV-Headers and SPIRV-Tools.

diff --git a/src/common/spirv/BUILD.gn b/src/common/spirv/BUILD.gn
index 116e263..a82570d 100644
--- a/src/common/spirv/BUILD.gn
+++ b/src/common/spirv/BUILD.gn
@@ -10,42 +10,47 @@ angle_source_set("angle_spirv_headers") {
   deps = [ "$angle_root:angle_common" ]
 }
 
-angle_source_set("angle_spirv_base") {
-  sources = [ "angle_spirv_utils.cpp" ]
-  deps = [
-    ":angle_spirv_headers",
-    "$angle_root:angle_common",
-    "${angle_spirv_headers_dir}:spv_headers",
-    "${angle_spirv_tools_dir}:spvtools_headers",
-  ]
+# Only the Vulkan backend (and fuzzing) uses SPIR-V, as _uses_spirv in //BUILD.gn says. Defined
+# unconditionally, these targets make gn gen load SPIRV-Headers' and SPIRV-Tools' BUILD.gn even
+# for a Metal-only build.
+if (angle_enable_vulkan || use_fuzzing_engine) {
+  angle_source_set("angle_spirv_base") {
+    sources = [ "angle_spirv_utils.cpp" ]
+    deps = [
+      ":angle_spirv_headers",
+      "$angle_root:angle_common",
+      "${angle_spirv_headers_dir}:spv_headers",
+      "${angle_spirv_tools_dir}:spvtools_headers",
+    ]
 
-  if (angle_debug_layers_enabled) {
-    deps += [ "$angle_spirv_tools_dir:spvtools_val" ]
+    if (angle_debug_layers_enabled) {
+      deps += [ "$angle_spirv_tools_dir:spvtools_val" ]
+    }
   }
-}
 
-angle_source_set("angle_spirv_builder") {
