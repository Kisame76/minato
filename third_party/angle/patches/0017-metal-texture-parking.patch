+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// mtl_texture_parking.h:
+//    Texture parking (Minato): near the process's memory limit, textures that were not used for a while are kept
+//    as a lossless compressed CPU copy and restored on their next use, so that an app that holds more textures
+//    than the device's memory allows keeps running with identical output.
+//
+
+#ifndef LIBANGLE_RENDERER_METAL_MTL_TEXTURE_PARKING_H_
+#define LIBANGLE_RENDERER_METAL_MTL_TEXTURE_PARKING_H_
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include "libANGLE/Error.h"
+#include "libANGLE/angletypes.h"
+#include "libANGLE/renderer/metal/mtl_format_utils.h"
+#include "libANGLE/renderer/metal/mtl_resources.h"
+
+namespace gl
+{
+class Context;
+}  // namespace gl
+
+namespace rx
+{
+class TextureMtl;
+
+namespace mtl
+{
+
+// One level of a parked texture inside the readback buffer and the packed bytes.
+struct ParkedLevel
+{
+    uint32_t width       = 0;
+    uint32_t height      = 0;
+    size_t bytesPerRow   = 0;
+    size_t offset        = 0;
+};
+
+enum class ParkCodec : uint8_t
+{
+    LZ4,
+    LZFSE,
+};
+
+// The packed bytes are independent chunks of 1 MiB of the filtered readback, so that a restore decodes them on
+// several cores at once.
+struct PackedChunk
+{
+    size_t rawOffset    = 0;
+    size_t rawSize      = 0;
+    size_t packedOffset = 0;
+    size_t packedSize   = 0;
+};
+
+// A texture on its way to (or in) the parked state. The context thread owns every field except the ones the
+// background worker fills before it sets |state| to Packed or Failed.
+struct ParkJob
+{
+    enum State : int
+    {
+        Reading,     // the readback blit is encoded; waits for its command buffer
+        Packing,     // a background worker filters and compresses the readback
+        Packed,      // |packed| holds the texture; the context thread may drop the storage
+        Failed,      // did not compress well enough; the texture stays as it is
+    };
+
+    BufferRef readback;
+    uint64_t serial = 0;
+    size_t rawSize  = 0;
+    std::vector<ParkedLevel> levels;
+    Format format;
+    gl::Extents size;
+    uint32_t mips          = 0;
+    uint64_t useCount      = 0;
+    uint64_t parkedAtMs    = 0;
+    std::atomic<int> state{Reading};
+
+    ParkCodec codec = ParkCodec::LZ4;
+    std::vector<uint8_t> packed;
+    std::vector<PackedChunk> chunks;
+
+    // Second pass: LZFSE for textures that stay parked.
+    std::atomic<int> repackState{0};  // 0 none, 1 running, 2 done, 3 failed, 4 taken
+    std::vector<uint8_t> repacked;
+    std::vector<PackedChunk> repackedChunks;
+
+    // Context-thread bookkeeping: what this job still counts in TextureParking.
+    bool countsPacking   = false;
+    bool countsRepacking = false;
+    // The texture was restored and not written since: |packed| still equals it, so parking it again only drops
+    // the GPU storage.
+    bool kept = false;
+    // Packed in the stress mode: kept even when packing saves nothing.
+    bool stress = false;
+};
+
+// How an entry point uses a texture: a write makes a kept packed copy stale.
+enum class ParkUse : uint8_t
+{
+    Read,
+    Write,
+};
+
+// Decodes a packed job into |out| (rawSize bytes) and undoes the row filter.
+bool UnpackParkedTexture(const ParkJob &job, uint8_t *out);
+
+// The process-wide registry of parkable textures and the policy that decides when to park.
+class TextureParking
+{
+  public:
+    static TextureParking &Get();
+
+    void add(TextureMtl *texture);
+    void remove(TextureMtl *texture);
+
+    // Called on a context's thread at the end of a frame (present, glFlush, glFinish).
+    angle::Result tick(const gl::Context *context);
+    // Called by texture uploads: a tick when the last one is more than a frame ago.
+    angle::Result tickFromUpload(const gl::Context *context);
+
+    void noteRestore(double milliseconds);
+    // A job the texture no longer needs (destroyed, or written after a restore): dropped once no worker uses it.
+    void orphan(std::shared_ptr<ParkJob> job);
+    int line(char *buffer, size_t size);
+
+    static uint64_t NowMs();
+
+  private:
+    TextureParking();
+
+    // Bytes the process may still allocate before the limit, or 0 when unknown (no parking then).
+    uint64_t availableBytes();
+    void dispatchPack(std::shared_ptr<ParkJob> job);
+    void dispatchRepack(std::shared_ptr<ParkJob> job);
+    // Releases what a job no longer needs: its worker slot, its readback buffer.
+    void settle(ParkJob *job);
+    // Moves the owner's jobs on: starts packs, takes packed ones (dropping the GPU storage), aborts used ones.
+    angle::Result advance(const gl::Context *context, const void *owner, uint64_t now, bool packHere);
+    angle::Result parkAll(const gl::Context *context, const void *owner, uint64_t now);
+    void reportFirst(uint64_t count);
+
+    std::recursive_mutex mMutex;
+    std::vector<TextureMtl *> mTextures;
+    std::vector<std::shared_ptr<ParkJob>> mOrphans;
+    uint64_t mLastTickMs  = 0;
+    bool mActive          = false;
+    uint64_t mLimitBytes  = 0;
+    bool mLimitRead       = false;
+    bool mStress          = false;
+    int mPacking          = 0;
+    int mRepacking        = 0;
+    size_t mPendingBytes  = 0;
+
+    // Statistics for the counters line.
+    uint64_t mParks        = 0;
+    uint64_t mAborts       = 0;
+    uint64_t mRestores     = 0;
+    uint64_t mRepacks      = 0;
+    std::vector<float> mRestoreMs;
+    size_t mRestoreNext = 0;
+
+    friend class ::rx::TextureMtl;
+};
+
+}  // namespace mtl
+}  // namespace rx
+
+#endif  // LIBANGLE_RENDERER_METAL_MTL_TEXTURE_PARKING_H_
