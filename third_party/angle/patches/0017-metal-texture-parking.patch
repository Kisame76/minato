+angle::Result TextureMtl::restoreIfParked(const gl::Context *context, mtl::ParkUse use)
+{
+    // A use only counts; the frame end turns the count into a time (texture parking).
+    ++mParkUseCount;
+    if (mParked)
+    {
+        ANGLE_TRY(restoreParked(context));
+    }
+    if (use == mtl::ParkUse::Write && mParkJob && mParkJob->kept)
+    {
+        // The packed copy no longer matches what is about to be written.
+        mtl::TextureParking::Get().orphan(std::move(mParkJob));
+    }
+    return angle::Result::Continue;
+}
+
+angle::Result TextureMtl::restoreParked(const gl::Context *context)
+{
+    const auto start           = std::chrono::steady_clock::now();
+    const mtl::ParkJob *job    = mParkJob.get();
+    mParked                    = false;
+    ContextMtl *contextMtl     = mtl::GetImpl(context);
+
+    mtl::BufferRef staging;
+    ANGLE_TRY(mtl::Buffer::MakeBufferWithStorageMode(contextMtl, MTLStorageModeShared, job->rawSize,
+                                                     &staging));
+    const bool unpacked =
+        mtl::UnpackParkedTexture(*job, static_cast<uint8_t *>([staging->get() contents]));
+    ANGLE_CHECK(contextMtl, unpacked, gl::err::kInternalError, GL_OUT_OF_MEMORY);
+    ANGLE_TRY(createNativeStorage(context, gl::TextureType::_2D, job->mips, 0, job->size, job->format));
+    const mtl::TextureRef &texture = mNativeTextureStorage->getNativeTexture();
+    mtl::BlitCommandEncoder *blit =
+        GetBlitCommandEncoderForResources(contextMtl, {staging.get(), texture.get()});
+    for (uint32_t level = 0; level < job->mips; ++level)
+    {
+        const mtl::ParkedLevel &parked = job->levels[level];
+        blit->copyBufferToTexture(staging, parked.offset, parked.bytesPerRow,
+                                  parked.bytesPerRow * parked.height,
+                                  MTLSizeMake(parked.width, parked.height, 1), texture, 0,
+                                  mtl::MipmapNativeLevel(level), MTLOriginMake(0, 0, 0),
+                                  MTLBlitOptionNone);
+    }
+    // Kept until the texture is written: parking it again then only drops the storage.
+    mParkJob->kept = true;
+    const double milliseconds =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    mtl::TextureParking::Get().noteRestore(milliseconds);
+    return angle::Result::Continue;
+}
+
+size_t TextureMtl::parkingCandidateBytes(uint64_t nowMs, uint64_t minIdleMs, size_t minBytes) const
+{
+    if (mParked || (mParkJob && !mParkJob->kept) || mNeverPark || !mNativeTextureStorage || mBoundSurface ||
+        nowMs < mParkRetryAfterMs || nowMs - mParkLastUseMs < minIdleMs)
+    {
+        return 0;
+    }
+    if (mState.getType() != gl::TextureType::_2D || mState.hasBeenBoundAsImage() ||
+        mState.hasBeenBoundAsAttachment() || mState.hasBeenBoundAsSourceOfEglImage() ||
+        mState.isExternalMemoryTexture() || mState.isInternalIncompleteTexture() ||
+        mState.hasProtectedContent())
+    {
+        return 0;
+    }
+    const angle::Format &format = mNativeTextureStorage->getFormat().actualAngleFormat();
+    const mtl::TextureRef &texture = mNativeTextureStorage->getNativeTexture();
+    if (format.isBlock || format.hasDepthOrStencilBits() || format.pixelBytes == 0 ||
+        texture->arrayLength() != 1 || texture->samples() > 1 ||
+        texture->get().storageMode == MTLStorageModeMemoryless)
+    {
+        return 0;
+    }
+    size_t bytes = 0;
+    for (uint32_t level = 0; level < texture->mipmapLevels(); ++level)
+    {
+        bytes += static_cast<size_t>(texture->width(mtl::MipmapNativeLevel(level))) *
+                 texture->height(mtl::MipmapNativeLevel(level)) * format.pixelBytes;
+    }
+    return bytes >= minBytes ? bytes : 0;
+}
+
+angle::Result TextureMtl::beginPark(const gl::Context *context)
+{
+    ContextMtl *contextMtl         = mtl::GetImpl(context);
+    const mtl::TextureRef &texture = mNativeTextureStorage->getNativeTexture();
+    auto job                       = std::make_shared<mtl::ParkJob>();
+    job->format                    = mNativeTextureStorage->getFormat();
+    job->mips                      = texture->mipmapLevels();
+    job->size     = gl::Extents(static_cast<int>(texture->widthAt0()),
+                                static_cast<int>(texture->heightAt0()), 1);
+    job->useCount = mParkUseCount;
+    const size_t pixelBytes = job->format.actualAngleFormat().pixelBytes;
+    size_t offset           = 0;
+    for (uint32_t level = 0; level < job->mips; ++level)
+    {
+        mtl::ParkedLevel parked;
+        parked.width       = texture->width(mtl::MipmapNativeLevel(level));
+        parked.height      = texture->height(mtl::MipmapNativeLevel(level));
+        parked.bytesPerRow = parked.width * pixelBytes;
+        parked.offset      = offset;
+        offset += parked.bytesPerRow * parked.height;
+        job->levels.push_back(parked);
+    }
+    job->rawSize = offset;
+    ANGLE_TRY(mtl::Buffer::MakeBufferWithStorageMode(contextMtl, MTLStorageModeShared, offset,
+                                                     &job->readback));
+    mtl::BlitCommandEncoder *blit =
+        GetBlitCommandEncoderForResources(contextMtl, {texture.get(), job->readback.get()});
+    for (uint32_t level = 0; level < job->mips; ++level)
+    {
+        const mtl::ParkedLevel &parked = job->levels[level];
+        blit->copyTextureToBuffer(texture, 0, mtl::MipmapNativeLevel(level), MTLOriginMake(0, 0, 0),
+                                  MTLSizeMake(parked.width, parked.height, 1), job->readback,
+                                  parked.offset, parked.bytesPerRow,
+                                  parked.bytesPerRow * parked.height, MTLBlitOptionNone);
+    }
+    job->serial = contextMtl->parkingCommandSerial();
+    mParkJob    = std::move(job);
+    return angle::Result::Continue;
+}
+
+angle::Result TextureMtl::dropParkedStorage(const gl::Context *context)
+{
+    // The image definitions keep their formats; their images are views of the storage and go with it.
+    std::map<int, gl::TexLevelArray<ImageDefinitionMtl>> definitions = std::move(mTexImageDefs);
+    deallocateNativeStorage(/*keepImages=*/false, /*keepSamplerStateAndFormat=*/true);
+    for (auto &face : definitions)
+    {
+        for (ImageDefinitionMtl &definition : face.second)
+        {
+            definition.image = nullptr;
+        }
+    }
+    mTexImageDefs  = std::move(definitions);
+    mParked        = true;
+    mParkJob->kept = false;
+    // The front end syncs the texture before its next use, which restores it; this context's bound textures
+    // are bound again.
+    onStateChange(angle::SubjectMessage::DirtyBitsFlagged);
+    mtl::GetImpl(context)->invalidateCurrentTextures();
+    return angle::Result::Continue;
+}
