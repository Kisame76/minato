+{
+
+constexpr uint64_t kMiB = 1024 * 1024;
+
+// When to park (ADR-0075). The process may still allocate |available| bytes before jetsam kills it.
+// Start below 1 GiB: a visual novel's frame sequence grew ~0.95 GB/s in our reproduction and a park takes a
+// frame plus one LZ4 encode, so 1 GiB is about one second of headroom at that rate.
+constexpr uint64_t kStartBelow = 1024 * kMiB;
+// Stop at 1.5 GiB: 512 MiB of hysteresis (~64 full-screen frames), so that parking does not toggle every frame
+// while an app creates and deletes textures in the same second.
+constexpr uint64_t kStopAt = 1536 * kMiB;
+// Below 384 MiB (~0.4 s at that rate) textures idle for two frames qualify too.
+constexpr uint64_t kEmergencyBelow = 384 * kMiB;
+// Below 128 MiB (~0.13 s, a few frames before a kill) the asynchronous parks are too late: the frame waits for
+// them, as a stall is better than a kill.
+constexpr uint64_t kStallBelow = 128 * kMiB;
+constexpr size_t kStallBudget   = 32 * kMiB;
+// Uploads tick too (an app may load for seconds before its first frame), at most this often.
+constexpr uint64_t kUploadTickMs = 16;
+constexpr uint64_t kIdleMs          = 500;
+constexpr uint64_t kEmergencyIdleMs = 33;
+// The readbacks count toward the footprint until they are packed; never more than this at once.
+constexpr size_t kPendingCap = 64 * kMiB;
+constexpr int kPackWorkers   = 2;
+// Textures packed this long ago are packed again with LZFSE on more workers: about twice as small as LZ4 on real
+// art and still restored within a frame, but ten times slower to pack, so only once per texture; two workers keep
+// up with an engine that cycles a few hundred frames.
+constexpr int kRepackWorkers      = 2;
+constexpr uint64_t kRepackAfterMs = 1000;
+// A pack must save at least an eighth, or the texture stays on the GPU (and is not tried again for 10 s).
+constexpr size_t kMinSavingShift = 3;
+constexpr uint64_t kRetryAfterMs = 10000;
+// Smaller textures are not worth the readback: a full-screen frame is 8 MiB, a 256 x 256 one 256 KiB.
+constexpr size_t kMinBytes = 256 * 1024;
+constexpr size_t kRestoreSamples = 512;
+
+compression_algorithm Algorithm(ParkCodec codec)
+{
+    return codec == ParkCodec::LZ4 ? COMPRESSION_LZ4 : COMPRESSION_LZFSE;
+}
+
+// Each row minus the row above, per byte: picture content becomes small values that compress 1.2-1.6x better.
+void FilterUp(uint8_t *bytes, const std::vector<ParkedLevel> &levels)
+{
+    for (const ParkedLevel &level : levels)
+    {
+        for (size_t y = level.height; y-- > 1;)
+        {
+            uint8_t *row         = bytes + level.offset + y * level.bytesPerRow;
+            const uint8_t *above = row - level.bytesPerRow;
+            for (size_t x = 0; x < level.bytesPerRow; ++x)
+            {
+                row[x] = static_cast<uint8_t>(row[x] - above[x]);
+            }
+        }
+    }
+}
+
+void UnfilterUp(uint8_t *bytes, const std::vector<ParkedLevel> &levels)
+{
+    for (const ParkedLevel &level : levels)
+    {
+        for (size_t y = 1; y < level.height; ++y)
+        {
+            uint8_t *row         = bytes + level.offset + y * level.bytesPerRow;
+            const uint8_t *above = row - level.bytesPerRow;
+            for (size_t x = 0; x < level.bytesPerRow; ++x)
+            {
+                row[x] = static_cast<uint8_t>(row[x] + above[x]);
+            }
+        }
+    }
+}
+
+constexpr size_t kChunkBytes = 1024 * 1024;
+
+// Packs |size| bytes as independent chunks; fails when the result would not save an eighth.
+bool Encode(const uint8_t *source,
+            size_t size,
+            ParkCodec codec,
+            bool anySaving,
+            std::vector<uint8_t> *out,
+            std::vector<PackedChunk> *chunks)
+{
+    // The stress mode parks whatever it can, even when packing does not save anything.
+    const size_t limit = anySaving ? size + size / 2 + 4096 : size - (size >> kMinSavingShift);
+    std::unique_ptr<uint8_t[]> buffer(new (std::nothrow) uint8_t[limit]);
+    if (!buffer)
+    {
+        return false;
+    }
+    std::vector<PackedChunk> parts;
+    size_t written = 0;
+    for (size_t offset = 0; offset < size; offset += kChunkBytes)
+    {
+        PackedChunk chunk;
+        chunk.rawOffset    = offset;
+        chunk.rawSize      = std::min(kChunkBytes, size - offset);
+        chunk.packedOffset = written;
+        chunk.packedSize   = compression_encode_buffer(buffer.get() + written, limit - written,
+                                                       source + offset, chunk.rawSize, nullptr,
+                                                       Algorithm(codec));
+        if (chunk.packedSize == 0)
+        {
+            return false;
+        }
+        written += chunk.packedSize;
+        parts.push_back(chunk);
+    }
+    out->assign(buffer.get(), buffer.get() + written);
+    *chunks = std::move(parts);
+    return true;
+}
+
+// Decodes every chunk into |out|, on several cores when |parallel| is set.
+bool Decode(const std::vector<uint8_t> &packed,
+            const std::vector<PackedChunk> &chunks,
+            ParkCodec codec,
+            uint8_t *out,
+            bool parallel)
+{
+    const uint8_t *source         = packed.data();
+    const PackedChunk *parts      = chunks.data();
+    const compression_algorithm a = Algorithm(codec);
+    std::atomic<size_t> failures{0};
+    std::atomic<size_t> *failed   = &failures;
+    auto one                      = ^(size_t index) {
+      const PackedChunk &chunk = parts[index];
+      if (compression_decode_buffer(out + chunk.rawOffset, chunk.rawSize, source + chunk.packedOffset,
+                                    chunk.packedSize, nullptr, a) != chunk.rawSize)
+      {
+          failed->fetch_add(1);
+      }
+    };
+    if (parallel)
+    {
+        dispatch_apply(chunks.size(), DISPATCH_APPLY_AUTO, one);
+    }
+    else
+    {
+        for (size_t index = 0; index < chunks.size(); ++index)
+        {
+            one(index);
+        }
+    }
+    return failures.load() == 0;
+}
+
+void Pack(ParkJob *job)
+{
+    uint8_t *bytes = static_cast<uint8_t *>([job->readback->get() contents]);
+    FilterUp(bytes, job->levels);
+    const bool packed = Encode(bytes, job->rawSize, ParkCodec::LZ4, job->stress, &job->packed, &job->chunks);
+    job->state.store(packed ? ParkJob::Packed : ParkJob::Failed, std::memory_order_release);
+}
+
+void Repack(ParkJob *job)
+{
+    std::unique_ptr<uint8_t[]> raw(new (std::nothrow) uint8_t[job->rawSize]);
+    bool ok = raw != nullptr &&
+              Decode(job->packed, job->chunks, job->codec, raw.get(), /*parallel=*/false) &&
+              Encode(raw.get(), job->rawSize, ParkCodec::LZFSE, false, &job->repacked, &job->repackedChunks) &&
+              job->repacked.size() < job->packed.size();
+    job->repackState.store(ok ? 2 : 3, std::memory_order_release);
+}
+
+uint64_t Footprint()
+{
+    task_vm_info_data_t info       = {};
+    mach_msg_type_number_t count   = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, reinterpret_cast<task_info_t>(&info), &count) !=
+        KERN_SUCCESS)
+    {
+        return 0;
+    }
+    return info.phys_footprint;
+}
+
+// Packs free memory the process may soon need, so they must not starve behind background work; repacks only save
+// more and may wait.
+dispatch_queue_t PackQueue()
+{
+    static dispatch_queue_t queue = dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0);
+    return queue;
+}
+
+dispatch_queue_t RepackQueue()
+{
+    static dispatch_queue_t queue = dispatch_get_global_queue(QOS_CLASS_UTILITY, 0);
+    return queue;
+}
+
+}  // namespace
+
+bool UnpackParkedTexture(const ParkJob &job, uint8_t *out)
+{
+    if (!Decode(job.packed, job.chunks, job.codec, out, /*parallel=*/true))
+    {
+        return false;
+    }
+    UnfilterUp(out, job.levels);
+    return true;
+}
+
+TextureParking &TextureParking::Get()
+{
+    static TextureParking *parking = [] {
+        TextureParking *created = new TextureParking();
+        // MINATO_ANGLE_PARK_REPORT: the counters line on stderr when the process exits (checks and device runs).
+        if (getenv("MINATO_ANGLE_PARK_REPORT") != nullptr)
+        {
+            atexit([] {
+                char line[256];
+                if (TextureParking::Get().line(line, sizeof(line)) > 0)
+                {
+                    fprintf(stderr, "angle %s\n", line);
+                }
+            });
+        }
+        return created;
+    }();
+    return *parking;
+}
+
+TextureParking::TextureParking() : mRestoreMs(kRestoreSamples, 0.0f) {}
+
+uint64_t TextureParking::NowMs()
+{
+    static mach_timebase_info_data_t timebase = [] {
+        mach_timebase_info_data_t info = {};
+        mach_timebase_info(&info);
+        return info;
+    }();
+    return mach_absolute_time() * timebase.numer / timebase.denom / 1000000;
+}
+
+void TextureParking::add(TextureMtl *texture)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    mTextures.push_back(texture);
+}
+
+void TextureParking::remove(TextureMtl *texture)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    auto found = std::find(mTextures.begin(), mTextures.end(), texture);
+    if (found != mTextures.end())
+    {
+        *found = mTextures.back();
+        mTextures.pop_back();
+    }
+}
+
+void TextureParking::orphan(std::shared_ptr<ParkJob> job)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    if (job->countsPacking || job->countsRepacking || job->readback)
+    {
+        mOrphans.push_back(std::move(job));
+    }
+}
+
+void TextureParking::settle(ParkJob *job)
+{
+    if (job->countsPacking && job->state.load(std::memory_order_acquire) != ParkJob::Packing)
+    {
+        job->countsPacking = false;
+        mPacking -= 1;
+    }
+    if (job->countsRepacking && job->repackState.load(std::memory_order_acquire) != 1)
+    {
+        job->countsRepacking = false;
+        mRepacking -= 1;
+    }
+    if (job->readback && !job->countsPacking)
+    {
+        job->readback = nullptr;
+        mPendingBytes -= job->rawSize;
+    }
+}
+
+// MINATO_ANGLE_PARK_REPORT: the counters on stderr at the first park and the first restore too, for processes that
+// end with _exit.
+void TextureParking::reportFirst(uint64_t count)
+{
+    if (count == 1 && getenv("MINATO_ANGLE_PARK_REPORT") != nullptr)
+    {
+        char buffer[256];
+        if (line(buffer, sizeof(buffer)) > 0)
+        {
+            fprintf(stderr, "angle %s\n", buffer);
+        }
+    }
+}
+
+uint64_t TextureParking::availableBytes()
+{
+    if (!mLimitRead)
+    {
+        mLimitRead        = true;
+        mStress           = getenv("MINATO_ANGLE_PARK_STRESS") != nullptr;
+        const char *limit = getenv("MINATO_ANGLE_PARK_LIMIT_MB");
+        if (limit != nullptr && atoll(limit) > 0)
+        {
+            mLimitBytes = static_cast<uint64_t>(atoll(limit)) * kMiB;
+        }
+    }
+    if (mLimitBytes != 0)
+    {
+        const uint64_t footprint = Footprint();
+        return footprint < mLimitBytes ? mLimitBytes - footprint : 1;
+    }
+#if TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR
+    return os_proc_available_memory();
+#else
+    return 0;
+#endif
+}
+
+void TextureParking::dispatchPack(std::shared_ptr<ParkJob> job)
+{
+    job->state.store(ParkJob::Packing, std::memory_order_relaxed);
+    job->countsPacking = true;
+    mPacking += 1;
+    dispatch_async(PackQueue(), ^{
+      Pack(job.get());
+    });
+}
+
+void TextureParking::dispatchRepack(std::shared_ptr<ParkJob> job)
+{
+    job->repackState.store(1, std::memory_order_relaxed);
+    job->countsRepacking = true;
+    mRepacking += 1;
+    dispatch_async(RepackQueue(), ^{
+      Repack(job.get());
+    });
+}
+
+angle::Result TextureParking::advance(const gl::Context *context,
+                                      const void *owner,
+                                      uint64_t now,
+                                      bool packHere)
+{
+    ContextMtl *contextMtl = GetImpl(context);
+    CommandQueue &queue    = contextMtl->getDisplay()->cmdQueue();
+
+    if (packHere)
+    {
+        // The frame waits: pack every finished readback now, on all cores.
+        std::vector<ParkJob *> ready;
+        for (TextureMtl *texture : mTextures)
+        {
+            ParkJob *job = texture->mParkJob.get();
+            if (texture->mParkOwner == owner && job != nullptr && !texture->mParked && !job->kept &&
+                job->state.load(std::memory_order_acquire) == ParkJob::Reading &&
+                texture->mParkUseCount == job->useCount && queue.isSerialCompleted(job->serial))
+            {
+                ready.push_back(job);
+            }
+        }
+        ParkJob *const *jobs = ready.data();
+        dispatch_apply(ready.size(), DISPATCH_APPLY_AUTO, ^(size_t index) {
+          Pack(jobs[index]);
+        });
+    }
+
+    for (size_t index = 0; index < mOrphans.size();)
+    {
+        settle(mOrphans[index].get());
+        ParkJob *job = mOrphans[index].get();
+        if (!job->countsPacking && !job->countsRepacking && !job->readback)
+        {
+            mOrphans[index] = std::move(mOrphans.back());
+            mOrphans.pop_back();
+            continue;
+        }
+        ++index;
+    }
+
+    for (TextureMtl *texture : mTextures)
+    {
+        if (texture->mParkOwner != owner)
+        {
+            continue;
+        }
+        if (texture->mParkUseCount != texture->mParkSeenUseCount)
+        {
+            texture->mParkSeenUseCount = texture->mParkUseCount;
+            texture->mParkLastUseMs    = now;
+        }
+        if (!texture->mParkJob)
+        {
+            continue;
+        }
+        std::shared_ptr<ParkJob> &job = texture->mParkJob;
+        if (texture->mParked || job->kept)
+        {
+            settle(job.get());
+            const int repack = job->repackState.load(std::memory_order_acquire);
+            if (repack == 2)
+            {
+                job->packed.swap(job->repacked);
+                job->chunks.swap(job->repackedChunks);
+                job->repacked       = std::vector<uint8_t>();
+                job->repackedChunks = std::vector<PackedChunk>();
+                job->codec    = ParkCodec::LZFSE;
+                mRepacks += 1;
+                job->repackState.store(4, std::memory_order_relaxed);
+            }
+            else if (repack == 0 && job->codec == ParkCodec::LZ4 && mRepacking < kRepackWorkers &&
+                     now - job->parkedAtMs >= kRepackAfterMs)
+            {
+                dispatchRepack(job);
+            }
+            continue;
+        }
+
+        if (job->state.load(std::memory_order_acquire) == ParkJob::Reading)
+        {
+            if (texture->mParkUseCount != job->useCount)
+            {
+                settle(job.get());
+                job = nullptr;
+                mAborts += 1;
+                continue;
+            }
+            if (!queue.isSerialCompleted(job->serial))
+            {
+                continue;
+            }
+            if (packHere)
+            {
+                Pack(job.get());
+            }
+            else if (mPacking < kPackWorkers)
+            {
+                dispatchPack(job);
+                continue;
+            }
+            else
+            {
+                continue;
+            }
+        }
+        if (packHere)
+        {
+            while (job->state.load(std::memory_order_acquire) == ParkJob::Packing)
+            {
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+        }
+
+        const int state = job->state.load(std::memory_order_acquire);
+        if (state == ParkJob::Packing)
+        {
+            continue;
+        }
+        settle(job.get());
+        if (state == ParkJob::Failed || texture->mParkUseCount != job->useCount)
+        {
+            if (state == ParkJob::Failed)
+            {
+                texture->mParkRetryAfterMs = now + kRetryAfterMs;
+            }
+            job = nullptr;
+            mAborts += 1;
+            continue;
+        }
+        job->parkedAtMs = now;
+        mParks += 1;
+        ANGLE_TRY(texture->dropParkedStorage(context));
+        reportFirst(mParks);
+    }
+    return angle::Result::Continue;
+}
+
+angle::Result TextureParking::tickFromUpload(const gl::Context *context)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    if (NowMs() - mLastTickMs < kUploadTickMs)
+    {
+        return angle::Result::Continue;
+    }
+    return tick(context);
+}
+
+angle::Result TextureParking::tick(const gl::Context *context)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    const uint64_t now = NowMs();
+    mLastTickMs        = now;
+    const void *owner  = context->getState().getShareGroup();
+    const uint64_t available = availableBytes();
+    if (available == 0 && !mStress && mParks == 0 && mPendingBytes == 0)
+    {
+        // No limit known (the Mac without MINATO_ANGLE_PARK_LIMIT_MB) and nothing ever parked: nothing to do.
+        return angle::Result::Continue;
+    }
+    ANGLE_TRY(advance(context, owner, now, /*packHere=*/false));
+
+    if (mStress)
+    {
+        // MINATO_ANGLE_PARK_STRESS (checks only): every frame end parks every texture that may be parked at all,
+        // of any size and idle for any time, so that a whole test suite runs through parks and restores.
+        return parkAll(context, owner, now);
+    }
+    if (available == 0)
+    {
+        return angle::Result::Continue;
+    }
+    if (available < kStartBelow)
+    {
+        mActive = true;
+    }
+    else if (available >= kStopAt)
+    {
+        mActive = false;
+    }
+    if (!mActive)
+    {
+        return angle::Result::Continue;
+    }
+
+    const bool emergency = available < kEmergencyBelow;
+    const uint64_t idle  = emergency ? kEmergencyIdleMs : kIdleMs;
+    // Readbacks count toward the footprint until packed: in the emergency band a quarter of what is left. In the
+    // stall band they are packed within this frame end, so a fixed budget lets parking go on even at the limit.
+    const size_t cap = available < kStallBelow ? kStallBudget
+                       : emergency             ? std::min<size_t>(kPendingCap, available / 4)
+                                               : kPendingCap;
+    // What the parks on their way will free: LZ4 saves a third of real art, often more.
+    uint64_t expected = mPendingBytes / 3;
+
+    std::vector<std::pair<uint64_t, TextureMtl *>> candidates;
+    for (TextureMtl *texture : mTextures)
+    {
+        if (texture->mParkOwner == owner && texture->parkingCandidateBytes(now, idle, kMinBytes) != 0)
+        {
+            candidates.emplace_back(texture->mParkLastUseMs, texture);
+        }
+    }
+    std::sort(candidates.begin(), candidates.end(),
+              [](const auto &a, const auto &b) { return a.first < b.first; });
+    bool started = false;
+    for (const auto &candidate : candidates)
+    {
+        TextureMtl *texture = candidate.second;
+        const size_t bytes  = texture->parkingCandidateBytes(now, idle, kMinBytes);
+        if (available + expected >= kStopAt)
+        {
+            break;
+        }
+        if (texture->mParkJob && texture->mParkJob->kept)
+        {
+            // Restored and unchanged since: its packed copy is current, so only the GPU storage goes.
+            expected += bytes;
+            mParks += 1;
+            ANGLE_TRY(texture->dropParkedStorage(context));
+            continue;
+        }
+        if (mPendingBytes + bytes > cap)
+        {
+            continue;
+        }
+        ANGLE_TRY(texture->beginPark(context));
+        mPendingBytes += bytes;
+        expected += bytes / 3;
+        started = true;
+    }
+
+    if (started && available >= kStallBelow)
+    {
+        // The readbacks run once their command buffer is committed; an app that loads for seconds without a frame
+        // end would leave them waiting.
+        GetImpl(context)->flushCommandBuffer(mtl::NoWait);
+    }
+    if (available < kStallBelow && (started || mPendingBytes != 0))
+    {
+        ANGLE_TRY(GetImpl(context)->finishCommandBuffer());
+        ANGLE_TRY(advance(context, owner, now, /*packHere=*/true));
+    }
+    return angle::Result::Continue;
+}
+
+angle::Result TextureParking::parkAll(const gl::Context *context, const void *owner, uint64_t now)
+{
+    for (TextureMtl *texture : mTextures)
+    {
+        if (texture->mParkOwner != owner || texture->parkingCandidateBytes(now, 0, 1) == 0)
+        {
+            continue;
+        }
+        if (texture->mParkJob && texture->mParkJob->kept)
+        {
+            mParks += 1;
+            ANGLE_TRY(texture->dropParkedStorage(context));
+            continue;
+        }
+        if (mPendingBytes < kPendingCap)
+        {
+            ANGLE_TRY(texture->beginPark(context));
+            texture->mParkJob->stress = true;
+            mPendingBytes += texture->mParkJob->rawSize;
+        }
+    }
+    return angle::Result::Continue;
+}
+
+void TextureParking::noteRestore(double milliseconds)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    mRestores += 1;
+    mRestoreMs[mRestoreNext % kRestoreSamples] = static_cast<float>(milliseconds);
+    mRestoreNext += 1;
+    reportFirst(mRestores);
+}
+
+int TextureParking::line(char *buffer, size_t size)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    const size_t samples = std::min(mRestoreNext, kRestoreSamples);
+    std::vector<float> sorted(mRestoreMs.begin(), mRestoreMs.begin() + static_cast<ptrdiff_t>(samples));
+    std::sort(sorted.begin(), sorted.end());
+    auto at = [&sorted](double share) {
+        return sorted.empty() ? 0.0
+                              : static_cast<double>(sorted[static_cast<size_t>(
+                                    share * static_cast<double>(sorted.size() - 1) + 0.5)]);
+    };
+    uint64_t parked = 0, raw = 0, packed = 0, kept = 0;
+    for (TextureMtl *texture : mTextures)
+    {
+        if (texture->mParkJob && texture->mParked)
+        {
+            parked += 1;
+            raw += texture->mParkJob->rawSize;
+            packed += texture->mParkJob->packed.size();
+        }
+        else if (texture->mParkJob && texture->mParkJob->kept)
+        {
+            kept += texture->mParkJob->packed.size();
+        }
+    }
+    const int length = snprintf(
+        buffer, size,
+        "park n=%llu raw=%llu packed=%llu kept=%llu pending=%llu parks=%llu aborts=%llu restores=%llu "
+        "restore_p50=%.1f restore_p99=%.1f lzfse=%llu",
+        static_cast<unsigned long long>(parked), static_cast<unsigned long long>(raw / kMiB),
+        static_cast<unsigned long long>(packed / kMiB), static_cast<unsigned long long>(kept / kMiB),
+        static_cast<unsigned long long>(mPendingBytes / kMiB), static_cast<unsigned long long>(mParks),
+        static_cast<unsigned long long>(mAborts), static_cast<unsigned long long>(mRestores), at(0.5),
+        at(0.99), static_cast<unsigned long long>(mRepacks));
+    return length > 0 && static_cast<size_t>(length) < size ? length : 0;
+}
+
+}  // namespace mtl
+}  // namespace rx
+
+// "park n=<parked> raw=<MiB> packed=<MiB> kept=<MiB> pending=<MiB> parks=<n> aborts=<n> restores=<n> restore_p50=<ms>
+// restore_p99=<ms> lzfse=<n>"; returns the length, or 0 when it does not fit.
+extern "C" ANGLE_EXPORT int ANGLEMetalParkingLine(char *line, size_t size)
+{
+    return rx::mtl::TextureParking::Get().line(line, size);
+}
