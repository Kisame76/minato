 #    include "libANGLE/renderer/metal/mtl_resource_spi.h"
 #endif
 
+#include <export.h>
+#include <objc/runtime.h>
+#include <array>
+#include <atomic>
+#include <cstdio>
+
+#include "common/unsafe_buffers.h"
+
+// Minato (patch 0015): what ANGLE holds in Metal, for an embedder's memory line. Every texture and
+// buffer the device makes gets an associated object that counts it by class until Metal frees it,
+// so a resource a command buffer still holds after its delete counts until it is really gone.
+namespace
+{
+enum MemoryClass : int
+{
+    kCompressed,
+    kColor,
+    kDepthStencil,
+    kMultisample,
+    kMemoryless,
+    kBufferShared,
+    kBufferPrivate,
+    kMemoryClasses
+};
+std::array<std::atomic<uint64_t>, kMemoryClasses> gCount;
+std::array<std::atomic<uint64_t>, kMemoryClasses> gBytes;
+std::atomic<uint64_t> gTexturePrivateBytes{0};
+std::atomic<int64_t> gPoolFreeCount{0};
+std::atomic<int64_t> gPoolFreeBytes{0};
+std::atomic<void *> gDevice{nullptr};
+char gTrackerKey;
+
+int TextureClass(id<MTLTexture> texture)
+{
+    if (texture.storageMode == MTLStorageModeMemoryless)
+    {
+        return kMemoryless;
+    }
+    if (texture.textureType == MTLTextureType2DMultisample ||
+        texture.textureType == MTLTextureType2DMultisampleArray)
+    {
+        return kMultisample;
+    }
+    switch (texture.pixelFormat)
+    {
+        case MTLPixelFormatDepth16Unorm:
+        case MTLPixelFormatDepth32Float:
+        case MTLPixelFormatStencil8:
+        case MTLPixelFormatDepth32Float_Stencil8:
+        case MTLPixelFormatX32_Stencil8:
+#if TARGET_OS_OSX || TARGET_OS_MACCATALYST
+        case MTLPixelFormatDepth24Unorm_Stencil8:
+        case MTLPixelFormatX24_Stencil8:
+#endif
+            return kDepthStencil;
+        default:
+            break;
+    }
+    // BC, PVRTC, EAC/ETC2 and ASTC (LDR and HDR) lie in these ranges of MTLPixelFormat.
+    const NSUInteger format = texture.pixelFormat;
+    return (format >= 130 && format <= 153) || (format >= 160 && format <= 235) ? kCompressed : kColor;
+}
+
+void RememberDevice(id<MTLDevice> device)
+{
+    void *expected = nullptr;
+    if (device != nil && gDevice.load(std::memory_order_acquire) == nullptr &&
+        gDevice.compare_exchange_strong(expected, (__bridge void *)device))
+    {
+        [device retain];
+    }
+}
+}  // namespace
+
+@interface MinatoANGLEMemoryTracker : NSObject
+{
+    int _memoryClass;
+    uint64_t _bytes;
+    BOOL _privateTexture;
+}
+@end
+
+@implementation MinatoANGLEMemoryTracker
+- (instancetype)initWithClass:(int)memoryClass bytes:(uint64_t)bytes privateTexture:(BOOL)privateTexture
+{
+    if ((self = [super init]))
+    {
+        _memoryClass    = memoryClass;
+        _bytes          = bytes;
+        _privateTexture = privateTexture;
+        gCount[memoryClass].fetch_add(1, std::memory_order_relaxed);
+        gBytes[memoryClass].fetch_add(bytes, std::memory_order_relaxed);
+        if (privateTexture)
+        {
+            gTexturePrivateBytes.fetch_add(bytes, std::memory_order_relaxed);
+        }
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    gCount[_memoryClass].fetch_sub(1, std::memory_order_relaxed);
+    gBytes[_memoryClass].fetch_sub(_bytes, std::memory_order_relaxed);
+    if (_privateTexture)
+    {
+        gTexturePrivateBytes.fetch_sub(_bytes, std::memory_order_relaxed);
+    }
+    [super dealloc];
+}
+@end
+
+namespace
+{
+void Track(id object, int memoryClass, uint64_t bytes, BOOL privateTexture)
+{
+    if (object == nil)
+    {
+        return;
+    }
+    MinatoANGLEMemoryTracker *tracker =
+        [[MinatoANGLEMemoryTracker alloc] initWithClass:memoryClass
+                                                  bytes:bytes
+                                         privateTexture:privateTexture];
+    objc_setAssociatedObject(object, &gTrackerKey, tracker, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    [tracker release];
+}
+
+void TrackTexture(id<MTLDevice> device, id<MTLTexture> texture)
+{
+    RememberDevice(device);
+    if (texture != nil)
+    {
+        Track(texture, TextureClass(texture), texture.allocatedSize,
+              texture.storageMode == MTLStorageModePrivate);
+    }
+}
+
+void TrackBuffer(id<MTLDevice> device, id<MTLBuffer> buffer)
+{
+    RememberDevice(device);
+    if (buffer != nil)
+    {
+        Track(buffer, buffer.storageMode == MTLStorageModePrivate ? kBufferPrivate : kBufferShared,
+              buffer.allocatedSize, NO);
+    }
+}
+
+uint64_t Load(const std::atomic<uint64_t> &value)
+{
+    return value.load(std::memory_order_relaxed);
+}
+
+uint64_t LoadSigned(const std::atomic<int64_t> &value)
+{
+    const int64_t loaded = value.load(std::memory_order_relaxed);
+    return loaded > 0 ? static_cast<uint64_t>(loaded) : 0;
+}
+}  // namespace
+
+// The counters in this order, appended to and never reordered: for each class (compressed, color,
+// depth/stencil, multisample and memoryless textures, shared and private buffers) its count and
+// bytes (values 0 to 13), the textures' private and shared bytes (14, 15), the buffer manager's
+// free buffers and their bytes (16, 17), and the device's currentAllocatedSize (18). Writes at most
+// `count` values and returns how many there are.
+extern "C" ANGLE_EXPORT size_t ANGLEMetalMemoryCounters(uint64_t *values, size_t count)
+{
+    std::array<uint64_t, 19> all = {};
+    uint64_t textureBytes = 0;
+    for (int k = 0; k < kMemoryClasses; ++k)
+    {
+        all[2 * k]     = Load(gCount[k]);
+        all[2 * k + 1] = Load(gBytes[k]);
+        if (k <= kMemoryless)
+        {
+            textureBytes += all[2 * k + 1];
+        }
+    }
+    all[14] = Load(gTexturePrivateBytes);
+    all[15] = textureBytes > all[14] ? textureBytes - all[14] : 0;
+    all[16] = LoadSigned(gPoolFreeCount);
+    all[17] = LoadSigned(gPoolFreeBytes);
+    id<MTLDevice> device = (__bridge id<MTLDevice>)gDevice.load(std::memory_order_acquire);
+    all[18]              = device != nil ? device.currentAllocatedSize : 0;
+    for (size_t k = 0; values != nullptr && k < count && k < all.size(); ++k)
+    {
+        ANGLE_UNSAFE_TODO(values[k] = all[k]);
+    }
+    return all.size();
+}
+
+// The counters as one line, sizes in MiB: "gl tex=<n>/<MiB> priv=.. shared=.. comp=<n>/.. color=<n>/..
+// depth=<n>/.. msaa=<n>/.. mless=<n> buf=<n>/.. bufpriv=.. pool=<n>/.. mtl=..". Returns its length,
+// or 0 if it does not fit in `size` bytes (the terminating zero included). No allocation.
+extern "C" ANGLE_EXPORT int ANGLEMetalMemoryLine(char *line, size_t size)
+{
+    std::array<uint64_t, 19> v = {};
+    ANGLEMetalMemoryCounters(v.data(), v.size());
+    const uint64_t mib = 1024 * 1024;
+    const unsigned long long textures = v[0] + v[2] + v[4] + v[6] + v[8];
+    const unsigned long long buffers  = v[10] + v[12];
+    const int length = ANGLE_UNSAFE_TODO(std::snprintf(
+        line, size,
+        "gl tex=%llu/%llu priv=%llu shared=%llu comp=%llu/%llu color=%llu/%llu depth=%llu/%llu "
+        "msaa=%llu/%llu mless=%llu buf=%llu/%llu bufpriv=%llu pool=%llu/%llu mtl=%llu",
+        textures, (unsigned long long)((v[14] + v[15]) / mib), (unsigned long long)(v[14] / mib),
+        (unsigned long long)(v[15] / mib), (unsigned long long)v[0], (unsigned long long)(v[1] / mib),
+        (unsigned long long)v[2], (unsigned long long)(v[3] / mib), (unsigned long long)v[4],
+        (unsigned long long)(v[5] / mib), (unsigned long long)v[6], (unsigned long long)(v[7] / mib),
+        (unsigned long long)v[8], buffers, (unsigned long long)((v[11] + v[13]) / mib),
+        (unsigned long long)(v[13] / mib), (unsigned long long)v[16], (unsigned long long)(v[17] / mib),
+        (unsigned long long)(v[18] / mib)));
+    return length > 0 && static_cast<size_t>(length) < size ? length : 0;
+}
