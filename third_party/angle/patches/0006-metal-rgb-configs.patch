--- a/src/libANGLE/renderer/metal/SurfaceMtl.mm
+++ b/src/libANGLE/renderer/metal/SurfaceMtl.mm
@@ -84,7 +84,9 @@
 {
     mRobustResourceInit =
         attribs.get(EGL_ROBUST_RESOURCE_INITIALIZATION_ANGLE, EGL_FALSE) == EGL_TRUE;
-    mColorFormat = display->getPixelFormat(angle::FormatID::B8G8R8A8_UNORM);
+    // Minato (patch 0006): a config without alpha draws into BGRA8 with ANGLE's emulated alpha, kept at 1.
+    mColorFormat = display->getPixelFormat(state.config->alphaSize == 0 ? angle::FormatID::B8G8R8X8_UNORM
+                                                                       : angle::FormatID::B8G8R8A8_UNORM);
 
     mSamples = state.config->samples;
 
@@ -689,6 +691,8 @@
         if (!mColorTexture)
         {
             mColorTexture = mtl::Texture::MakeFromMetal(mCurrentDrawable.get().texture);
+            // Minato (patch 0006): the drawables of a config without alpha take no alpha writes.
+            mColorTexture->setColorWritableMask(mtl::GetEmulatedColorWriteMask(mColorFormat));
             ASSERT(!mColorRenderTarget.getTexture());
             mColorRenderTarget.setWithImplicitMSTexture(mColorTexture, mMSColorTexture,
                                                         mtl::kZeroNativeMipLevel, 0, mColorFormat);
