+    std::mutex mMutex;
+    int mFd     = -1;
+    bool mTried = false;
+    std::map<uint64_t, uint64_t> mFree;
+    uint64_t mEnd     = 0;
+    uint64_t mBytes   = 0;
+    uint64_t mWritten = 0;
+    uint64_t mFails   = 0;
+};
