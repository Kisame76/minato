+// A temporary buffer of its own pages: given back to the system when it goes, where a freed malloc block of this
+// size may stay in the footprint.
+class PageBuffer
+{
+  public:
+    explicit PageBuffer(size_t size) : mSize(size)
+    {
+        void *pages = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        mData       = pages == MAP_FAILED ? nullptr : static_cast<uint8_t *>(pages);
+    }
+    ~PageBuffer()
+    {
+        if (mData != nullptr)
+        {
+            munmap(mData, mSize);
+        }
+    }
+    PageBuffer(const PageBuffer &)            = delete;
+    PageBuffer &operator=(const PageBuffer &) = delete;
+    uint8_t *data() const { return mData; }
+
+  private:
+    uint8_t *mData = nullptr;
+    size_t mSize   = 0;
+};
