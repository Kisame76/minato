+// The park file (patch 0021): one file per process that holds the packed copies, so that they are not in the
+// footprint. Host memory (malloc) is charged to phys_footprint, which jetsam measures; clean file pages are not,
+// and the kernel may evict them under pressure and read them back on the next restore. The file is unlinked once
+// created, so nothing is left after an exit or a kill. Its extents are 16 KiB aligned (the page size), and freed
+// ones go back to the file system (F_PUNCHHOLE). When the file cannot take a copy (it could not be created, the
+// disk has less than kFileMinFree, a write fails) the copy stays in host memory as before.
+// MINATO_ANGLE_PARK_FILE=0 keeps every copy in host memory.
+constexpr uint64_t kFileBlock   = 16 * 1024;
+constexpr uint64_t kFileMinFree = 2048 * kMiB;
+
+class ParkFile
+{
+  public:
+    static ParkFile &Get()
+    {
+        static ParkFile *file = new ParkFile();
+        return *file;
+    }
+
+    // Writes |size| bytes into a free extent; false keeps them in host memory.
+    bool store(const uint8_t *bytes, size_t size, uint64_t *offset)
+    {
+        const uint64_t length = (size + kFileBlock - 1) / kFileBlock * kFileBlock;
+        uint64_t at           = 0;
+        int fd                = -1;
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            if (!open() || size == 0)
+            {
+                return false;
+            }
+            struct statfs disk = {};
+            if (fstatfs(mFd, &disk) != 0 ||
+                static_cast<uint64_t>(disk.f_bavail) * disk.f_bsize < kFileMinFree + length)
+            {
+                mFails += 1;
+                return false;
+            }
+            at = take(length);
+            fd = mFd;
+        }
+        for (size_t done = 0; done < size;)
+        {
+            const ssize_t wrote = pwrite(fd, bytes + done, size - done, static_cast<off_t>(at + done));
+            if (wrote <= 0)
+            {
+                std::lock_guard<std::mutex> lock(mMutex);
+                give(at, length);
+                mFails += 1;
+                return false;
+            }
+            done += static_cast<size_t>(wrote);
+        }
+        std::lock_guard<std::mutex> lock(mMutex);
+        mBytes += length;
+        mWritten += size;
+        *offset = at;
+        return true;
+    }
+
+    bool load(uint64_t offset, uint8_t *out, size_t size) const
+    {
+        for (size_t done = 0; done < size;)
+        {
+            const ssize_t read = pread(mFd, out + done, size - done, static_cast<off_t>(offset + done));
+            if (read <= 0)
+            {
+                return false;
+            }
+            done += static_cast<size_t>(read);
+        }
+        return true;
+    }
+
+    void release(uint64_t offset, size_t size)
+    {
+        const uint64_t length = (size + kFileBlock - 1) / kFileBlock * kFileBlock;
+        std::lock_guard<std::mutex> lock(mMutex);
+        mBytes -= length;
+        give(offset, length);
+    }
+
+    void counters(uint64_t *bytes, uint64_t *written, uint64_t *fails)
+    {
+        std::lock_guard<std::mutex> lock(mMutex);
+        *bytes   = mBytes;
+        *written = mWritten;
+        *fails   = mFails;
+    }
+
+  private:
+    bool open()
+    {
+        if (mTried)
+        {
+            return mFd >= 0;
+        }
+        mTried            = true;
+        const char *flag  = getenv("MINATO_ANGLE_PARK_FILE");
+        if (flag != nullptr && strcmp(flag, "0") == 0)
+        {
+            return false;
+        }
+        // The process's own temporary directory: the app's tmp on iOS.
+        char directory[1024];
+        if (confstr(_CS_DARWIN_USER_TEMP_DIR, directory, sizeof(directory)) == 0)
+        {
+            mFails += 1;
+            return false;
+        }
+        std::string path = std::string(directory) + "/angle-park.XXXXXX";
+        mFd              = mkstemp(path.data());
+        if (mFd < 0)
+        {
+            mFails += 1;
+            return false;
+        }
+        unlink(path.c_str());
+        fcntl(mFd, F_SETFD, FD_CLOEXEC);
+#if TARGET_OS_IPHONE
+        // Class D (no protection): a locked phone does not take the reads away from a running app. If iOS keeps
+        // the container's class, the file is readable from the first unlock on, which a running app is past.
+        fcntl(mFd, F_SETPROTECTIONCLASS, 4);
+#endif
+        return true;
+    }
+
+    // First fit among the freed extents, else the end of the file.
+    uint64_t take(uint64_t length)
+    {
+        for (auto it = mFree.begin(); it != mFree.end(); ++it)
+        {
+            if (it->second >= length)
+            {
+                const uint64_t at   = it->first;
+                const uint64_t left = it->second - length;
+                mFree.erase(it);
+                if (left != 0)
+                {
+                    mFree.emplace(at + length, left);
+                }
+                return at;
+            }
+        }
+        const uint64_t at = mEnd;
+        mEnd += length;
+        return at;
+    }
+
+    // Frees an extent, merges it with its neighbours and gives the blocks back to the file system.
+    void give(uint64_t at, uint64_t length)
+    {
+        fpunchhole_t hole = {};
+        hole.fp_offset    = static_cast<off_t>(at);
+        hole.fp_length    = static_cast<off_t>(length);
+        fcntl(mFd, F_PUNCHHOLE, &hole);
+        auto next = mFree.lower_bound(at);
+        if (next != mFree.end() && at + length == next->first)
+        {
+            length += next->second;
+            next = mFree.erase(next);
+        }
+        if (next != mFree.begin())
+        {
+            auto previous = std::prev(next);
+            if (previous->first + previous->second == at)
+            {
+                at = previous->first;
+                length += previous->second;
+                mFree.erase(previous);
+            }
+        }
+        if (at + length == mEnd)
+        {
+            mEnd = at;
+            ftruncate(mFd, static_cast<off_t>(mEnd));
+            return;
+        }
+        mFree.emplace(at, length);
+    }
