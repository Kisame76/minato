-bool TextureParking::keepRestored()
+angle::Result TextureParking::beforeRestore(const gl::Context *context, size_t bytes)
+{
+    std::lock_guard<std::recursive_mutex> lock(mMutex);
+    ContextMtl *contextMtl = GetImpl(context);
+    if (mStagingBytes != 0 && contextMtl->getDisplay()->cmdQueue().isSerialCompleted(mStagingSerial))
+    {
+        mStagingBytes = 0;
+    }
+    if (mStagingBytes != 0 && mStagingBytes + bytes > kStagingCap && !mStress)
+    {
+        const uint64_t available = availableBytes();
+        if (available != 0 && available < kStartBelow)
+        {
+            // A restore runs from a texture's sync before a draw, outside any encoder.
+            ANGLE_TRY(contextMtl->finishCommandBuffer());
+            mStagingBytes = 0;
+        }
+    }
+    mStagingBytes += bytes;
+    mStagingSerial = contextMtl->parkingCommandSerial();
+    return angle::Result::Continue;
+}
+
+size_t TextureParking::dropKept(const void *owner)
+{
+    // Such a texture is read back and packed again when it qualifies.
+    size_t bytes = 0;
+    for (TextureMtl *texture : mTextures)
+    {
+        if (texture->mParkOwner == owner && texture->mParkJob && texture->mParkJob->kept)
+        {
+            bytes += texture->mParkJob->packed.size();
+            mUnkept += 1;
+            orphan(std::move(texture->mParkJob));
+        }
+    }
+    return bytes;
+}
+
+bool TextureParking::keepRestored(const gl::Context *context)
 {
