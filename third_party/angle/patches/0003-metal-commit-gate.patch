+
+// Minato (patch 0003): the embedder's gate before every commit, its second function once the
+// command buffer is counted as committed, and its wait until everything committed is scheduled
+// (Minato's ADR-0029, decision 15). The second function comes for each command buffer that passed
+// the gate, after ANGLEMetalWaitUntilScheduled counts it.
+extern "C" ANGLE_EXPORT void ANGLEMetalSetCommitGates(void (*gate)(void), void (*counted)(void))
+{
+    rx::mtl::gCommitCounted.store(counted, std::memory_order_release);
+    rx::mtl::gCommitGate.store(gate, std::memory_order_release);
+}
+
+// 1 once every command buffer committed so far, on every queue, is scheduled; 0 after the timeout.
+extern "C" ANGLE_EXPORT int ANGLEMetalWaitUntilScheduled(double timeoutSeconds)
+{
+    using Clock = std::chrono::steady_clock;
+    const Clock::time_point deadline =
+        Clock::now() +
+        std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double>(timeoutSeconds));
+    std::lock_guard<std::mutex> lg(rx::mtl::gQueuesLock);
+    for (const rx::mtl::CommandQueue *queue : rx::mtl::gQueues)
+    {
+        const Clock::duration left = std::max(deadline - Clock::now(), Clock::duration::zero());
+        const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(left).count();
+        if (!queue->waitUntilCommittedScheduled(static_cast<uint64_t>(ns)))
+        {
+            return 0;
+        }
+    }
+    return 1;
+}
